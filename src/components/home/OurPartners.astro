---
import { fetchAllCollections, isShopEnabled } from '../../lib/shop';
import type { ShopCollection } from '../../lib/shop';

function getShortDescription(description: string): string {
  if (!description) return '';
  const firstSentence = description.match(/^[^.]+\./)?.[0] ?? description;
  if (firstSentence.length > 120) {
    return firstSentence.slice(0, 117).replace(/\s+$/, '') + '...';
  }
  return firstSentence;
}

const shopEnabled = isShopEnabled();
let partners: ShopCollection[] = [];

if (shopEnabled) {
  try {
    const storyblokToken =
      Astro.locals.runtime?.env?.STORYBLOK_TOKEN ??
      import.meta.env.STORYBLOK_TOKEN;
    const { collections } = await fetchAllCollections(storyblokToken);
    /*
     * Having an image is the curation signal here: a brand appears as a partner
     * only once someone has uploaded its logo. Automatic collection covers must
     * therefore be excluded — they are product photos the catalog migration
     * picks for the shop's brand tiles, and counting them would parade every
     * brand through this strip with a photo of a handpan captioned as its logo.
     */
    partners = collections.filter(
      (c) => c.image && !c.imageIsAutoCover && c.productCount > 0
    );
  } catch {
    // Fail silently — section will be hidden
  }
}

const shouldRender = shopEnabled && partners.length > 0;
---

{
  shouldRender && (
    <section class="partners" aria-labelledby="partners-heading">
      <div class="container">
        <div class="partners__header">
          <span class="partners__eyebrow" aria-hidden="true">
            Partners
          </span>
          <h2 id="partners-heading" class="partners__title">
            Our Partners
          </h2>
          <p class="partners__subtitle">
            We work with leading handpan makers and accessory brands from around
            the world.
          </p>
        </div>

        <ul class="partners__grid" aria-label="Our partner brands">
          {partners.map((partner) => (
            <li>
              <a
                href={`/shop/${partner.handle}/`}
                class="partner-card"
                aria-label={`${partner.title} — view collection`}
              >
                <div class="partner-card__logo-wrapper">
                  <img
                    src={partner.image!.url}
                    alt={partner.image!.altText || `${partner.title} logo`}
                    class="partner-card__logo"
                    loading="lazy"
                    width="260"
                    height="260"
                  />
                </div>
                <div class="partner-card__content">
                  <h3 class="partner-card__name">{partner.title}</h3>
                  {getShortDescription(partner.description) && (
                    <p class="partner-card__description">
                      {getShortDescription(partner.description)}
                    </p>
                  )}
                  <span class="partner-card__count">
                    {partner.productCount}{' '}
                    {partner.productCount === 1 ? 'product' : 'products'}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <div class="partners__cta">
          <a href="/shop/" class="partners__cta-link">
            Browse all brands
            <svg
              class="partners__cta-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )
}

<style lang="scss">
  .partners {
    padding: var(--space-16) 0;
    background-color: var(--color-gray-100);

    // Matches the global `.section` rhythm (64/128px). This component does not
    // carry the `.section` class, so the global rule cannot reach it.
    @media (min-width: 768px) {
      padding: var(--space-32) 0;
    }
  }

  // Left-set, matching FeaturedProducts. Centring is a good accent and a weak
  // default; used in four of six homepage sections it flattened the page.
  .partners__header {
    margin-bottom: var(--space-12);
  }

  .partners__eyebrow {
    display: block;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .partners__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-light);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
    line-height: var(--line-height-tight);
  }

  .partners__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-gray-600);
    max-width: 56ch;
    line-height: var(--line-height-relaxed);
  }

  .partners__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--transition-fast);
    height: 100%;

    &:hover {
      box-shadow: 0 0 0 1px var(--color-primary-light);
    }

    &:focus-visible {
      outline: 2px solid var(--color-gray-900);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .partner-card__logo-wrapper {
    aspect-ratio: 1;
    background: var(--color-gray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    overflow: hidden;
  }

  .partner-card__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .partner-card__content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;

    @media (min-width: 768px) {
      padding: var(--space-4) var(--space-5);
    }
  }

  .partner-card__name {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
    line-height: var(--line-height-tight);

    @media (min-width: 768px) {
      font-size: var(--font-size-lg);
    }
  }

  .partner-card__description {
    font-size: var(--font-size-xs);
    color: var(--color-gray-600);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-2);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    @media (min-width: 768px) {
      font-size: var(--font-size-sm);
      -webkit-line-clamp: 3;
    }
  }

  .partner-card__count {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray-600);
  }

  .partners__cta {
    text-align: center;
    margin-top: var(--space-10);
  }

  .partners__cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-base);
    text-decoration: none;
    min-height: 44px;
    // The site's link pattern: a 1px rule that fades in, not a browser
    // underline that snaps. See FeaturedProducts `__view-all`.
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);

    &:hover {
      color: var(--color-primary-dark);
      border-bottom-color: var(--color-primary-dark);
    }

    &:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
      border-radius: var(--radius-sm);
    }
  }

  .partners__cta-icon {
    width: 16px;
    height: 16px;
  }
</style>
