---
/**
 * One finished event, as a row.
 *
 * The archive used to reuse `EventCard`, so a finished event still advertised
 * a 200px photo, its price, "~1.5 hours" and "Max 15 participants" — capacity
 * is meaningless once an event is over and price is trivia, while what a
 * reader of an archive actually wants (what kind of thing it was, who taught
 * it) was buried in a truncated paragraph. At ~560px per card, 32 events ran
 * to eleven screens; at ~96px per row they fit in three.
 *
 * Emits none of the `data-acuity-*` / `data-booking-cta` hooks that
 * `availability-hydration.ts` looks for: a past row has no booking CTA and
 * must not be picked up by it.
 */
import type { EventStory } from '../types/event';
import { getEventCategory, getLevelLabel, UNCATEGORISED } from '../utils/tags';
import { storyblokImage } from '../lib/storyblokImage';
import { extractTeacherName } from '../lib/eventMatching';
import { formatRowDate, formatShortDate } from '../lib/eventFormat';

export interface Props {
  event: EventStory;
  /** End of the event's final occurrence — how the archive files it. */
  ranAt: Date;
  /** The same class running again, when one was matched. */
  runsAgainAt?: Date | null;
}

const { event, ranAt, runsAgainAt = null } = Astro.props;

/** The thumbnail paints at 68×51; 160×120 covers a 2× display. */
const THUMB_WIDTH = 160;
const THUMB_HEIGHT = 120;

const eventUrl = `/events/${event.slug}/`;
const { date, time } = formatRowDate(ranAt);

const category = getEventCategory(event.content.tags);
const meta = [
  category,
  getLevelLabel(event.content.tags)?.toLowerCase(),
  extractTeacherName(event.content.title),
].filter(Boolean);

const thumbnail = event.content.image
  ? storyblokImage(event.content.image.filename, THUMB_WIDTH, THUMB_HEIGHT)
  : null;
---

<li class="past-row" data-past-row data-category={category ?? UNCATEGORISED}>
  <a class="past-row__link" href={eventUrl}>
    <span class="past-row__date">
      <span class="past-row__day">{date}</span>
      <span class="past-row__time">{time}</span>
    </span>

    <span class="past-row__thumb">
      {
        thumbnail && (
          <img
            src={thumbnail}
            alt=""
            width={THUMB_WIDTH}
            height={THUMB_HEIGHT}
            loading="lazy"
            decoding="async"
          />
        )
      }
    </span>

    <span class="past-row__body">
      <span class="past-row__title">{event.content.title}</span>
      {
        meta.length > 0 && (
          <span class="past-row__meta">{meta.join(' · ')}</span>
        )
      }
    </span>

    {
      /* "Runs again" is the one fact this row exists to surface and it appears
        nowhere else in the row, so it stays in the link's accessible name.
        Only the arrow, and the "Details" label that merely restates the link,
        are hidden from assistive tech. */
    }
    <span class:list={['past-row__action', { 'is-recurring': runsAgainAt }]}>
      {
        runsAgainAt ? (
          <>
            Runs again {formatShortDate(runsAgainAt)}
            <span aria-hidden="true"> →</span>
          </>
        ) : (
          <span aria-hidden="true">Details →</span>
        )
      }
    </span>
  </a>
</li>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .past-row {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-hairline);

    &:last-child {
      border-bottom: 0;
    }
  }

  // The whole row is one link — no nested interactive elements, so the row is
  // a single tab stop.
  .past-row__link {
    display: grid;
    grid-template-columns: 92px 68px 1fr auto;
    gap: var(--spacing-md);
    align-items: center;
    min-height: 44px;
    padding: var(--spacing-md) var(--spacing-lg);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--transition-fast);

    &:hover,
    &:focus-visible {
      background: var(--color-gray-50);
    }
  }

  .past-row__date {
    display: flex;
    flex-direction: column;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .past-row__time {
    color: var(--color-gray-400);
  }

  .past-row__thumb {
    display: block;
    height: 52px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-gray-200);
    border-radius: var(--border-radius-sm);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  .past-row__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .past-row__title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .past-row__meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .past-row__action {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    white-space: nowrap;

    // A past event that runs again is the one thing on this page a warm lead
    // can act on, so it gets the bronze.
    &.is-recurring {
      color: var(--color-primary);
      font-weight: var(--font-weight-medium);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .past-row__link {
      transition: none;
    }
  }

  // The thumbnail is the first thing to go: at this width the title and its
  // meta line need the room more than a 68px photo does.
  @media (max-width: 768px) {
    .past-row__link {
      grid-template-columns: 92px 1fr;
      gap: var(--spacing-sm) var(--spacing-md);
      padding: var(--spacing-md);
    }

    .past-row__thumb {
      display: none;
    }

    .past-row__action {
      grid-column: 2;
    }
  }
</style>
