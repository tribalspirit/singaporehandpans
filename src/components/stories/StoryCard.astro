---
import { storyblokImageTransform } from '../../lib/galleryApi';
import { HYPHEN_TO_SPACE_REGEX } from '../../utils/tags';
import type { ArticleSummary } from '../../types/stories';

export interface Props {
  article: ArticleSummary;
}

const { article } = Astro.props;
const coverSrc = article.coverSrc
  ? storyblokImageTransform(article.coverSrc, 800, 600)
  : '';
const dateLabel = article.date
  ? new Date(article.date).toLocaleDateString('en-SG', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
const formatTag = (tag: string): string =>
  tag.replace(HYPHEN_TO_SPACE_REGEX, ' ');
---

<a class="story-card" href={`/stories/${article.slug}/`}>
  <div class="story-card__media">
    {
      coverSrc ? (
        <img
          class="story-card__image"
          src={coverSrc}
          alt={article.coverAlt}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="story-card__placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="story-card__body">
    {
      (dateLabel || article.tags.length > 0) && (
        <div class="story-card__meta">
          {dateLabel && <time datetime={article.date}>{dateLabel}</time>}
          {article.tags[0] && (
            <span class="story-card__tag">{formatTag(article.tags[0])}</span>
          )}
        </div>
      )
    }
    <h2 class="story-card__title">{article.title}</h2>
    {article.excerpt && <p class="story-card__excerpt">{article.excerpt}</p>}
    <span class="story-card__cta">Read story →</span>
  </div>
</a>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .story-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--transition-normal);

    &:hover {
      box-shadow: 0 0 0 1px var(--color-primary-light);
    }

    &:focus-visible {
      outline: 2px solid var(--color-gray-900);
      outline-offset: 2px;
    }
  }

  .story-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-gray-200);
  }

  .story-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);

    .story-card:hover & {
      transform: scale(1.02);
    }
  }

  .story-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-gray-200);
  }

  .story-card__body {
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    flex: 1;
  }

  .story-card__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray-600);
  }

  .story-card__tag {
    background: var(--color-accent-light);
    color: var(--color-accent-dark);
    padding: 2px var(--spacing-sm);
    border-radius: var(--radius-sm);
    font-family: var(--font-family-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: var(--font-weight-medium);
  }

  .story-card__title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    line-height: 1.25;
  }

  .story-card__excerpt {
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: var(--font-size-md);
  }

  .story-card__cta {
    margin-top: auto;
    color: var(--color-primary);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .story-card,
    .story-card__image {
      transition: none;
    }
  }
</style>
