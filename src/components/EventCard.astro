---
import type { EventStory } from '../types/event';
import { getEventCategory, getLevelLabel } from '../utils/tags';
import { getAcuityHooks } from '../lib/eventsApi';
import { storyblokImage, storyblokSrcSet } from '../lib/storyblokImage';
import { isStudioLocation } from '../lib/eventLocation';
import {
  getEventTiming,
  getNextOccurrence,
  getSingaporeParts,
  type EventOccurrence,
  type EventTiming,
} from '../lib/eventDates';
import {
  resolveDurationLabel,
  formatEventDateRange,
  formatEventTimeRange,
  formatOccurrenceLabel,
  formatRecurrenceLabel,
  formatSeriesSpanLabel,
  formatPrice,
} from '../lib/eventFormat';

export interface Props {
  event: EventStory;
  isPast?: boolean;
  /** Precomputed by `partitionEvents`; derived here for standalone callers. */
  timing?: EventTiming | null;
  next?: EventOccurrence | null;
  /**
   * Above-the-fold cards load their image eagerly. Everything else stays lazy —
   * previously the whole grid was lazy, including the first row, which delayed
   * the largest contentful paint on purpose.
   */
  eager?: boolean;
}

const { event, isPast = false, timing, next, eager = false } = Astro.props;

/**
 * The **1× CSS size** of the image well, which is what `srcset`'s `w`
 * descriptors and `sizes` are measured against — not a pre-doubled value.
 * Doubling here instead would have the browser fetch 2× of an already-2×
 * asset. `storyblokSrcSet` derives the 2× and 3× candidates.
 */
const WELL_WIDTH = 350;
const WELL_HEIGHT = 200;

/** Fallback for browsers without `srcset`; also sets the intrinsic ratio. */
const FALLBACK_DENSITY = 2;
const IMAGE_WIDTH = WELL_WIDTH * FALLBACK_DENSITY;
const IMAGE_HEIGHT = WELL_HEIGHT * FALLBACK_DENSITY;

/** Fallback excerpt length, cut on a word boundary rather than mid-word. */
const EXCERPT_LIMIT = 160;

const eventUrl = `/events/${event.slug}/`;

// One category chip and one collapsed level string, instead of a run of four
// identical chips mixing two taxonomies.
const category = getEventCategory(event.content.tags);
const levelLabel = getLevelLabel(event.content.tags);

const now = new Date();
const eventTiming = timing ?? getEventTiming(event.content);
const nextOccurrence =
  next ?? (eventTiming ? getNextOccurrence(eventTiming, now) : null);

// A recurring class shows its cadence rather than one specific date; past ones
// show the span they ran for, since they appear once in the archive, not once
// per session.
const recurrenceLabel = eventTiming ? formatRecurrenceLabel(eventTiming) : null;
const seriesSpanLabel =
  isPast && eventTiming ? formatSeriesSpanLabel(eventTiming) : null;

// For a live series the headline date is the next session, not the first one
// (which may be months ago). For a one-off it is the event's own span.
const showNextSession = Boolean(recurrenceLabel && nextOccurrence && !isPast);
const dateLabel = eventTiming ? formatEventDateRange(eventTiming) : '';
const timeLabel = eventTiming ? formatEventTimeRange(eventTiming) : '';

const isSameSingaporeDay = (a: Date, b: Date) => {
  const left = getSingaporeParts(a);
  const right = getSingaporeParts(b);
  return (
    left.year === right.year &&
    left.month === right.month &&
    left.day === right.day
  );
};

// Past cards carry no badge at all. Otherwise: a session under way says so
// (previously these read "Upcoming" right up until they were dropped from the
// page mid-class), then today — and nothing otherwise. Every card on the
// upcoming page used to read "Upcoming", inside a section that said so too, so
// the badge drew the eye without carrying information.
const statusBadge = (() => {
  if (isPast || !nextOccurrence) return null;
  if (nextOccurrence.start <= now && now <= nextOccurrence.end) {
    return 'Happening now';
  }
  return isSameSingaporeDay(nextOccurrence.start, now) ? 'Today' : null;
})();

const isSoldOut =
  event.content.sold_out_override ||
  event.content.availability_status === 'sold_out';
const availabilityStatus = event.content.availability_status || 'available';
const availabilityLabel: Record<string, string> = {
  available: 'Available',
  few_spots: 'Few Spots Left',
  sold_out: 'Sold Out',
};

// A duration beside an exact time range is noise — "~1.5 hours" next to
// "10:30 am – 12:00 pm" restates it, and the tilde makes an exact time read as
// approximate. It survives only where a cadence is shown instead of a range.
const durationLabel = recurrenceLabel
  ? resolveDurationLabel(eventTiming, event.content.duration)
  : null;

const priceLabel = formatPrice(event.content.price);

// Shown only when it is somewhere other than the studio. The default is stated
// once at page level, under the tabs.
const locationLabel = isStudioLocation(event.content.location)
  ? null
  : event.content.location;

const imageSrc = storyblokImage(
  event.content.image?.filename,
  IMAGE_WIDTH,
  IMAGE_HEIGHT
);
// Densities chosen against measured well widths, not picked round: the grid
// puts 361-466px slots on desktop and up to 718px at the 768px breakpoint.
// 1.5x (525w) serves desktop 1x, which would otherwise jump to 700w for a
// 380px slot; 2.25x (788w) serves desktop 2x, which needs ~750 and would
// otherwise jump to 1050w. 4x (1400w) is the ceiling: a 2x tablet at the 768px
// breakpoint wants 1436, and the 2.5% shortfall is not worth another variant.
const imageSrcSet = storyblokSrcSet(
  event.content.image?.filename,
  WELL_WIDTH,
  WELL_HEIGHT,
  { densities: [1, 1.5, 2.25, 3, 4] }
);

/**
 * A one-sentence `excerpt` when the CMS has one; otherwise the description cut
 * on a word boundary. The old `substring(0, 120)` cut mid-word and, on entries
 * whose description opens with a bullet list, cut inside the list.
 */
const excerpt = (() => {
  const written = event.content.excerpt?.trim();
  if (written) return written;

  const description = event.content.description?.trim() ?? '';
  if (description.length <= EXCERPT_LIMIT) return description;

  const cut = description.slice(0, EXCERPT_LIMIT);
  const lastSpace = cut.lastIndexOf(' ');
  return `${(lastSpace > 0 ? cut.slice(0, lastSpace) : cut).replace(/[\s,;:.–—-]+$/, '')}…`;
})();

// A series must not advertise its first class instance — see `getAcuityHooks`.
const acuityHooks = getAcuityHooks(event.content, eventTiming, nextOccurrence);
---

<article
  class={`event-card ${isPast ? 'past-event' : ''}`}
  data-acuity-class-id={acuityHooks.classId}
  data-acuity-appointment-type-id={acuityHooks.appointmentTypeId}
  data-acuity-month={acuityHooks.month}
  data-acuity-time={acuityHooks.time}
  data-booking-url={event.content.booking_url || undefined}
  data-sold-out-override={event.content.sold_out_override ? 'true' : undefined}
>
  <div class="event-image">
    {
      event.content.image ? (
        <img
          src={imageSrc}
          srcset={imageSrcSet ?? undefined}
          sizes="(max-width: 768px) 100vw, (max-width: 1199px) 50vw, 380px"
          width={IMAGE_WIDTH}
          height={IMAGE_HEIGHT}
          alt={event.content.image.alt || event.content.title}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding={eager ? 'sync' : 'async'}
        />
      ) : (
        <div class="placeholder-image">
          <svg
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="3" />
            <path d="m12 1 0 6m0 6 0 6" />
            <path d="m1 12 6 0m6 0 6 0" />
          </svg>
        </div>
      )
    }

    {statusBadge && <div class="event-status">{statusBadge}</div>}

    {
      !isPast && availabilityStatus !== 'available' && (
        <div
          class={`event-availability event-availability--${availabilityStatus}`}
          data-availability-badge
        >
          {availabilityLabel[availabilityStatus]}
        </div>
      )
    }
  </div>

  <div class="event-content">
    <header class="event-header">
      <h3>
        <a href={eventUrl}>{event.content.title}</a>
      </h3>

      {
        (category || levelLabel) && (
          <div class="event-tags">
            {category && <span class="tag">{category}</span>}
            {levelLabel && <span class="event-level">{levelLabel}</span>}
          </div>
        )
      }
    </header>

    <div class="event-details">
      <div class="event-datetime">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <div>
          {
            recurrenceLabel ? (
              <>
                <div class="date">{recurrenceLabel}</div>
                {showNextSession && nextOccurrence && (
                  <div class="time">
                    Next: {formatOccurrenceLabel(nextOccurrence)}
                  </div>
                )}
                {seriesSpanLabel && <div class="time">{seriesSpanLabel}</div>}
              </>
            ) : (
              <>
                <div class="date">{dateLabel}</div>
                <div class="time">{timeLabel}</div>
              </>
            )
          }
        </div>
      </div>

      {
        locationLabel && (
          <div class="event-location">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>{locationLabel}</span>
          </div>
        )
      }

      {
        priceLabel && (
          <div class="event-price">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="12" y1="1" x2="12" y2="23" />
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
            <span class={priceLabel === 'Free' ? 'free-price' : ''}>
              {priceLabel}
            </span>
          </div>
        )
      }

      {
        durationLabel && (
          <div class="event-duration">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>{durationLabel}</span>
          </div>
        )
      }

      {
        /* Capacity lives on the detail page. On a card it was identical across
          nine of ten events, so it distinguished nothing while displacing
          what does differ. */
      }
    </div>

    <p class="event-description">{excerpt}</p>

    <div class="event-actions">
      <a href={eventUrl} class="btn btn-outline"> Learn More</a>

      {
        /* Sold out stays a <span> for keyboard accessibility; hydration swaps
           the element when live availability disagrees. */
        !isPast && isSoldOut ? (
          <span
            class="btn btn-primary btn-disabled"
            data-booking-cta
            data-cta-class="btn btn-primary"
            data-cta-disabled-class="btn-disabled"
          >
            Sold Out
          </span>
        ) : !isPast && event.content.booking_url ? (
          <a
            href={event.content.booking_url}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
            data-booking-cta
            data-cta-class="btn btn-primary"
            data-cta-disabled-class="btn-disabled"
          >
            Book Now
          </a>
        ) : null
      }
    </div>
  </div>
</article>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .event-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
    height: 100%;
    display: flex;
    flex-direction: column;

    &:hover {
      box-shadow: 0 0 0 1px var(--color-primary-light);
      border-color: var(--color-primary-light);
    }

    // No dimming on past cards. `opacity: 0.8` plus `grayscale(30%)` muddied
    // the photography — the best material on the site — and the 0.8 multiplied
    // against already-secondary text, pushing --color-gray-600 body copy below
    // the contrast it was chosen for. On a page where everything is past, the
    // treatment carried no information anyway.
    &.past-event .event-status {
      background: var(--color-text-secondary);
    }
  }

  .event-image {
    position: relative;
    // Scales with the card instead of a fixed 200px, so a wide card is not a
    // letterbox slot. Storyblok's smart crop picks the subject; see
    // `storyblokImage`.
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-background-secondary);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .placeholder-image {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: var(--color-text-secondary);
      background: var(--color-gray-200);
    }

    .event-status {
      position: absolute;
      top: var(--spacing-sm);
      right: var(--spacing-sm);
      background: var(--color-gray-900);
      color: white;
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--border-radius-sm);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    }

    &:hover img {
      transform: scale(1.05);
    }

    .event-availability {
      position: absolute;
      top: var(--spacing-sm);
      left: var(--spacing-sm);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--border-radius-sm);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);

      &--few_spots {
        background: var(--color-warning);
        color: var(--color-white);
      }

      &--sold_out {
        background: var(--color-error);
        color: var(--color-white);
      }
    }
  }

  .event-content {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .event-header {
    margin-bottom: var(--spacing-md);

    h3 {
      margin: 0 0 var(--spacing-sm) 0;

      // No min-height here. The 44px target comes from the card being
      // clickable, not from padding a heading — forcing it opened a pocket of
      // dead space under every one-line title.
      a {
        color: var(--color-text-primary);
        text-decoration: none;
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-semibold);
        line-height: 1.3;

        &:hover {
          color: var(--color-primary);
        }
      }
    }
  }

  // Two marks, not four chips: one category on a ground, one level as plain
  // secondary text. A run of identical chips mixing format and level tags read
  // as one undifferentiated list.
  .event-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-xs) var(--spacing-sm);

    .tag {
      background: var(--color-accent-light);
      color: var(--color-gray-900);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--border-radius-sm);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
    }
  }

  .event-level {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .event-details {
    margin-bottom: var(--spacing-md);

    > div {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-sm);
      font-size: var(--font-size-sm);
      color: var(--color-gray-700);

      svg {
        color: var(--color-primary);
        flex-shrink: 0;
      }

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  .event-datetime {
    .date {
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-primary);
    }

    .time {
      font-size: var(--font-size-xs);
      margin-top: 2px;
    }
  }

  // Mono numerals, matching the date treatment.
  .event-price span {
    font-family: var(--font-family-mono);
  }

  .event-price {
    .free-price {
      color: var(--color-success-dark);
      font-weight: var(--font-weight-semibold);
    }
  }

  // Clamped visually rather than cut in the string, so the trim is a layout
  // concern and a full sentence survives when it fits.
  .event-description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
    flex: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .event-actions {
    display: flex;
    gap: var(--spacing-sm);
    margin-top: auto;

    // The primary action takes twice the width of the secondary. Equal halves
    // read as two equally-weighted choices, so booking carried only half the
    // card's intent.
    .btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      text-align: center;
      padding: var(--spacing-sm) var(--spacing-md);
      border-radius: var(--border-radius-md);
      text-decoration: none;
      font-weight: var(--font-weight-semibold);
      font-size: var(--font-size-sm);
      transition:
        background-color var(--transition-fast),
        color var(--transition-fast),
        border-color var(--transition-fast);
      border: 1px solid transparent;

      // Ink and a hairline, matching `.btn--outline` on the homepage. Bronze
      // here made a secondary action carry more colour weight than the ink
      // primary sitting next to it. Note the single-hyphen class name — this
      // is a separate variant from the BEM `.btn--outline`, which is why the
      // round-2 sweep did not reach it.
      &.btn-outline {
        color: var(--color-gray-900);
        border-color: var(--color-hairline-strong);
        background: transparent;

        &:hover {
          background: var(--color-gray-900);
          color: var(--color-white);
          border-color: var(--color-gray-900);
        }
      }

      &.btn-primary {
        flex: 2;
        background: var(--color-gray-900);
        color: var(--color-white);

        &:hover {
          background: var(--color-gray-800);
        }
      }

      &.btn-disabled.btn-primary {
        flex: 2;
      }

      &.btn-disabled {
        background: var(--color-text-secondary);
        color: white;
        cursor: not-allowed;
        pointer-events: none;
        opacity: 0.7;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-image img {
      transition: none;
    }

    .event-image:hover img {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .event-card {
      margin-bottom: var(--spacing-lg);
    }

    .event-content {
      padding: var(--spacing-md);
    }

    .event-actions {
      flex-direction: column;

      .btn {
        flex: none;
      }
    }
  }
</style>
