---
import type { EventStory } from '../types/event';
import { normalizeTags } from '../utils/tags';
import { getAcuityHooks } from '../lib/eventsApi';
import {
  getEventTiming,
  getNextOccurrence,
  getSingaporeParts,
  type EventOccurrence,
  type EventTiming,
} from '../lib/eventDates';
import {
  resolveDurationLabel,
  formatEventDateRange,
  formatEventTimeRange,
  formatOccurrenceLabel,
  formatRecurrenceLabel,
  formatSeriesSpanLabel,
} from '../lib/eventFormat';

export interface Props {
  event: EventStory;
  isPast?: boolean;
  /** Precomputed by `partitionEvents`; derived here for standalone callers. */
  timing?: EventTiming | null;
  next?: EventOccurrence | null;
}

const { event, isPast = false, timing, next } = Astro.props;

const eventTags = normalizeTags(event.content.tags);
const eventUrl = `/events/${event.slug}/`;

const now = new Date();
const eventTiming = timing ?? getEventTiming(event.content);
const nextOccurrence =
  next ?? (eventTiming ? getNextOccurrence(eventTiming, now) : null);

// A recurring class shows its cadence rather than one specific date; past ones
// show the span they ran for, since they appear once in the archive, not once
// per session.
const recurrenceLabel = eventTiming ? formatRecurrenceLabel(eventTiming) : null;
const seriesSpanLabel =
  isPast && eventTiming ? formatSeriesSpanLabel(eventTiming) : null;

// For a live series the headline date is the next session, not the first one
// (which may be months ago). For a one-off it is the event's own span.
const showNextSession = Boolean(recurrenceLabel && nextOccurrence && !isPast);
const dateLabel = eventTiming ? formatEventDateRange(eventTiming) : '';
const timeLabel = eventTiming ? formatEventTimeRange(eventTiming) : '';

const isSameSingaporeDay = (a: Date, b: Date) => {
  const left = getSingaporeParts(a);
  const right = getSingaporeParts(b);
  return (
    left.year === right.year &&
    left.month === right.month &&
    left.day === right.day
  );
};

// Past cards carry no badge at all. Otherwise: a session under way says so
// (previously these read "Upcoming" right up until they were dropped from the
// page mid-class), then today, then everything else.
const statusBadge = (() => {
  if (isPast || !nextOccurrence) return null;
  if (nextOccurrence.start <= now && now <= nextOccurrence.end) {
    return 'Happening now';
  }
  return isSameSingaporeDay(nextOccurrence.start, now) ? 'Today' : 'Upcoming';
})();

const isSoldOut =
  event.content.sold_out_override ||
  event.content.availability_status === 'sold_out';
const availabilityStatus = event.content.availability_status || 'available';
const availabilityLabel: Record<string, string> = {
  available: 'Available',
  few_spots: 'Few Spots Left',
  sold_out: 'Sold Out',
};

const durationLabel = resolveDurationLabel(eventTiming, event.content.duration);

// A series must not advertise its first class instance — see `getAcuityHooks`.
const acuityHooks = getAcuityHooks(event.content, eventTiming, nextOccurrence);
---

<article
  class={`event-card ${isPast ? 'past-event' : ''}`}
  data-acuity-class-id={acuityHooks.classId}
  data-acuity-appointment-type-id={acuityHooks.appointmentTypeId}
  data-acuity-month={acuityHooks.month}
  data-acuity-time={acuityHooks.time}
  data-booking-url={event.content.booking_url || undefined}
  data-sold-out-override={event.content.sold_out_override ? 'true' : undefined}
>
  <div class="event-image">
    {
      event.content.image ? (
        <img
          src={event.content.image.filename}
          alt={event.content.image.alt || event.content.title}
          loading="lazy"
        />
      ) : (
        <div class="placeholder-image">
          <svg
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="3" />
            <path d="m12 1 0 6m0 6 0 6" />
            <path d="m1 12 6 0m6 0 6 0" />
          </svg>
        </div>
      )
    }

    {statusBadge && <div class="event-status">{statusBadge}</div>}

    {
      !isPast && availabilityStatus !== 'available' && (
        <div
          class={`event-availability event-availability--${availabilityStatus}`}
          data-availability-badge
        >
          {availabilityLabel[availabilityStatus]}
        </div>
      )
    }
  </div>

  <div class="event-content">
    <header class="event-header">
      <h3>
        <a href={eventUrl}>{event.content.title}</a>
      </h3>

      {
        eventTags.length > 0 && (
          <div class="event-tags">
            {eventTags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="event-details">
      <div class="event-datetime">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <div>
          {
            recurrenceLabel ? (
              <>
                <div class="date">{recurrenceLabel}</div>
                {showNextSession && nextOccurrence && (
                  <div class="time">
                    Next: {formatOccurrenceLabel(nextOccurrence)}
                  </div>
                )}
                {seriesSpanLabel && <div class="time">{seriesSpanLabel}</div>}
              </>
            ) : (
              <>
                <div class="date">{dateLabel}</div>
                <div class="time">{timeLabel}</div>
              </>
            )
          }
        </div>
      </div>

      <div class="event-location">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{event.content.location}</span>
      </div>

      {
        event.content.price && (
          <div class="event-price">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="12" y1="1" x2="12" y2="23" />
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
            <span
              class={
                event.content.price.toLowerCase() === 'free' ? 'free-price' : ''
              }
            >
              {event.content.price}
            </span>
          </div>
        )
      }

      {
        durationLabel && (
          <div class="event-duration">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>~{durationLabel}</span>
          </div>
        )
      }

      {
        event.content.max_participants && (
          <div class="event-capacity">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            <span>Max {event.content.max_participants} participants</span>
          </div>
        )
      }
    </div>

    <p class="event-description">
      {
        event.content.description.length > 120
          ? event.content.description.substring(0, 120) + '...'
          : event.content.description
      }
    </p>

    <div class="event-actions">
      <a href={eventUrl} class="btn btn-outline"> Learn More</a>

      {
        /* Sold out stays a <span> for keyboard accessibility; hydration swaps
           the element when live availability disagrees. */
        !isPast && isSoldOut ? (
          <span
            class="btn btn-primary btn-disabled"
            data-booking-cta
            data-cta-class="btn btn-primary"
            data-cta-disabled-class="btn-disabled"
          >
            Sold Out
          </span>
        ) : !isPast && event.content.booking_url ? (
          <a
            href={event.content.booking_url}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
            data-booking-cta
            data-cta-class="btn btn-primary"
            data-cta-disabled-class="btn-disabled"
          >
            Book Now
          </a>
        ) : null
      }
    </div>
  </div>
</article>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .event-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
    height: 100%;
    display: flex;
    flex-direction: column;

    &:hover {
      box-shadow: 0 0 0 1px var(--color-primary-light);
      border-color: var(--color-primary-light);
    }

    &.past-event {
      opacity: 0.8;

      .event-image {
        filter: grayscale(30%);
      }

      .event-status {
        background: var(--color-text-secondary);
      }
    }
  }

  .event-image {
    position: relative;
    height: 200px;
    overflow: hidden;
    background: var(--color-background-secondary);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .placeholder-image {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: var(--color-text-secondary);
      background: var(--color-gray-200);
    }

    .event-status {
      position: absolute;
      top: var(--spacing-sm);
      right: var(--spacing-sm);
      background: var(--color-gray-900);
      color: white;
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--border-radius-sm);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    }

    &:hover img {
      transform: scale(1.05);
    }

    .event-availability {
      position: absolute;
      top: var(--spacing-sm);
      left: var(--spacing-sm);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--border-radius-sm);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);

      &--few_spots {
        background: var(--color-warning);
        color: var(--color-white);
      }

      &--sold_out {
        background: var(--color-error);
        color: var(--color-white);
      }
    }
  }

  .event-content {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .event-header {
    margin-bottom: var(--spacing-md);

    h3 {
      margin: 0 0 var(--spacing-sm) 0;

      a {
        color: var(--color-text-primary);
        text-decoration: none;
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-semibold);
        line-height: 1.3;
        min-height: 44px;
        display: inline-flex;
        align-items: center;

        &:hover {
          color: var(--color-primary);
        }

        @media (min-width: 1280px) {
          min-height: 32px;
        }
      }
    }
  }

  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);

    .tag {
      background: var(--color-accent-light);
      color: var(--color-gray-900);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--border-radius-sm);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      text-transform: capitalize;
    }
  }

  .event-details {
    margin-bottom: var(--spacing-md);

    > div {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-sm);
      font-size: var(--font-size-sm);
      color: var(--color-gray-700);

      svg {
        color: var(--color-primary);
        flex-shrink: 0;
      }

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  .event-datetime {
    .date {
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-primary);
    }

    .time {
      font-size: var(--font-size-xs);
      margin-top: 2px;
    }
  }

  .event-price {
    .free-price {
      color: var(--color-success-dark);
      font-weight: var(--font-weight-semibold);
    }
  }

  .event-description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
    flex: 1;
  }

  .event-actions {
    display: flex;
    gap: var(--spacing-sm);
    margin-top: auto;

    .btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      text-align: center;
      padding: var(--spacing-sm) var(--spacing-md);
      border-radius: var(--border-radius-md);
      text-decoration: none;
      font-weight: var(--font-weight-semibold);
      font-size: var(--font-size-sm);
      transition:
        background-color var(--transition-fast),
        color var(--transition-fast),
        border-color var(--transition-fast);
      border: 1px solid transparent;

      // Ink and a hairline, matching `.btn--outline` on the homepage. Bronze
      // here made a secondary action carry more colour weight than the ink
      // primary sitting next to it. Note the single-hyphen class name — this
      // is a separate variant from the BEM `.btn--outline`, which is why the
      // round-2 sweep did not reach it.
      &.btn-outline {
        color: var(--color-gray-900);
        border-color: var(--color-hairline-strong);
        background: transparent;

        &:hover {
          background: var(--color-gray-900);
          color: var(--color-white);
          border-color: var(--color-gray-900);
        }
      }

      &.btn-primary {
        background: var(--color-gray-900);
        color: var(--color-white);

        &:hover {
          background: var(--color-gray-800);
        }
      }

      &.btn-disabled {
        background: var(--color-text-secondary);
        color: white;
        cursor: not-allowed;
        pointer-events: none;
        opacity: 0.7;
      }
    }
  }

  @media (max-width: 768px) {
    .event-card {
      margin-bottom: var(--spacing-lg);
    }

    .event-content {
      padding: var(--spacing-md);
    }

    .event-actions {
      flex-direction: column;

      .btn {
        flex: none;
      }
    }
  }
</style>
