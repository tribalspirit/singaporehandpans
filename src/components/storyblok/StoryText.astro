---
import { storyblokEditable } from '@storyblok/astro';
import type { SbBlokData } from '@storyblok/astro';
import { renderRichText } from '../../lib/richtext';
import type { StoryTextBlok } from '../../types/stories';

export interface Props {
  blok: StoryTextBlok;
}

const { blok } = Astro.props;
// Rich text is authored by trusted studio editors and rendered server-side to
// HTML. The link mark is hardened in `renderRichText` (scheme allowlist +
// rel="noopener"), so `set:html` is safe here. See src/lib/richtext.ts.
const html = renderRichText(blok.content);
---

{
  html && (
    <div
      class="story-prose"
      set:html={html}
      {...storyblokEditable(blok as unknown as SbBlokData)}
    />
  )
}

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .story-prose {
    color: var(--color-text-secondary);
    line-height: 1.75;
    font-size: var(--font-size-md);

    :global(p) {
      margin-bottom: var(--spacing-md);

      &:last-child {
        margin-bottom: 0;
      }
    }

    :global(h2),
    :global(h3),
    :global(h4) {
      color: var(--color-text-primary);
      margin-top: var(--spacing-xl);
      margin-bottom: var(--spacing-md);
      line-height: 1.3;
    }

    :global(h2) {
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-semibold);
    }

    :global(h3) {
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
    }

    :global(ul),
    :global(ol) {
      margin-bottom: var(--spacing-md);
      padding-left: var(--spacing-lg);

      :global(li) {
        margin-bottom: var(--spacing-xs);
      }
    }

    :global(blockquote) {
      border-left: 4px solid var(--color-primary);
      padding-left: var(--spacing-lg);
      margin: var(--spacing-lg) 0;
      font-style: italic;
      color: var(--color-text-secondary);
    }

    :global(a) {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 2px;

      &:hover {
        text-decoration: none;
      }
    }

    :global(img) {
      max-width: 100%;
      height: auto;
    }
  }
</style>
