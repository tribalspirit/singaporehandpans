---
/**
 * Past classes and events, grouped by year and month.
 *
 * `/events/` used to render upcoming and past together, so the page grew
 * without bound — 34 of its 43 cards were finished classes. Nothing is
 * unpublished or deleted here: every past event keeps its detail page, its own
 * Event JSON-LD and its copy, it just lives on its own URL now.
 *
 * A recurring series appears once, filed under its final session, rather than
 * once per occurrence — N identical cards linking to one URL would be noise for
 * readers and duplicate links for crawlers.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import EventsTabs from '../../components/EventsTabs.astro';
import PastEventRow from '../../components/PastEventRow.astro';
import CMSFallback from '../../components/CMSFallback.astro';
import { getStoryblokClient } from '../../lib/storyblok';
import { setEdgeCache } from '../../lib/edgeCache';
import { fetchEventStories, partitionEvents } from '../../lib/eventsApi';
import { groupByYearMonth, getMonthLabel } from '../../lib/eventDates';
import { getEventCategory, UNCATEGORISED } from '../../utils/tags';
import {
  extractTeacherName,
  findRunsAgainMatch,
} from '../../lib/eventMatching';
import type { EventListItem } from '../../lib/eventsApi';

export const prerender = false;
// Long profile: the only thing that changes here is an event crossing the
// upcoming/past boundary, which happens at most once a day.
setEdgeCache(Astro.response, 'long');

/** Cap on how many entries the ItemList advertises; the page still shows all. */
const SCHEMA_ITEM_LIMIT = 100;

const now = new Date();

let pastEvents: EventListItem[] = [];
let upcomingEvents: EventListItem[] = [];
let cmsError = false;

const runtime = Astro.locals.runtime;
const token = runtime?.env?.STORYBLOK_TOKEN ?? import.meta.env.STORYBLOK_TOKEN;

try {
  const storyblokApi = getStoryblokClient(token);
  const storyblokVersion = import.meta.env.PROD ? 'published' : 'draft';

  const events = await fetchEventStories(storyblokApi, storyblokVersion);
  // Both halves: the page already fetched everything, so the upcoming count in
  // the tab strip and the "Runs again" matches cost no extra request.
  const partitioned = partitionEvents(events, now);
  pastEvents = partitioned.past;
  upcomingEvents = partitioned.upcoming;
} catch (error) {
  console.error('Events archive: Failed to load from Storyblok', error);
  cmsError = true;
}

// Grouped on the last occurrence's END, so a multi-day event files under the
// month it finished in and a series under the month its final session ran.
// Using `.start` filed a 30 Apr - 2 May event under April, contradicting the
// finish-month behaviour stated above.
const years = groupByYearMonth(pastEvents, (item) => item.last!.end);

// The jump nav lists years once there is more than one. With a single year that
// would be one useless chip, so it lists that year's months instead — which is
// the level a reader actually navigates at when everything is one season.
const jumpTargets =
  years.length > 1
    ? years.map((year) => ({
        anchor: year.anchor,
        label: String(year.year),
        count: year.total,
      }))
    : (years[0]?.months ?? []).map((month) => ({
        anchor: month.anchor,
        label: month.label,
        count: month.items.length,
      }));

/**
 * Filter chips, built from the categories actually present rather than a fixed
 * list — the CMS tag vocabulary and the live free-text data do not agree, and a
 * hardcoded chip reading "Masterclasses 0" would be worse than no chip.
 */
const categoryCounts = new Map<string, number>();
for (const item of pastEvents) {
  const key = getEventCategory(item.story.content.tags) ?? UNCATEGORISED;
  categoryCounts.set(key, (categoryCounts.get(key) ?? 0) + 1);
}

const filters = [
  { key: 'all', label: 'All', count: pastEvents.length },
  ...[...categoryCounts.entries()]
    .filter(([key]) => key !== UNCATEGORISED)
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .map(([key, count]) => ({ key, label: `${key}s`, count })),
];

/**
 * Each past event paired with the same class running again, so a reader who has
 * just learned they missed something is offered the next date instead of a dead
 * end. Conservative — see `findRunsAgainMatch`; a miss simply reads "Details".
 */
const runsAgainBySlug = new Map<string, { at: Date; url: string }>();
for (const item of pastEvents) {
  const match = findRunsAgainMatch(item, upcomingEvents);
  if (match?.next) {
    runsAgainBySlug.set(item.story.slug, {
      at: match.next.start,
      // The matched class's own URL, not the finished event's — the label
      // promises the next run, so that is where it has to lead.
      url: `/events/${match.story.slug}/`,
    });
  }
}

/**
 * The context line under the tabs: the span the archive covers and the teachers
 * in it. This is the credibility material the old entry link never mentioned.
 */
const TEACHERS_NAMED = 4;
const archiveContext = (() => {
  if (pastEvents.length === 0) return null;

  const newest = years[0];
  const oldestYear = years[years.length - 1];
  const oldest = oldestYear.months[oldestYear.months.length - 1];
  const span =
    newest.year === oldestYear.year
      ? `${getMonthLabel(oldest.month).slice(0, 3)}–${getMonthLabel(newest.months[0].month).slice(0, 3)} ${newest.year}`
      : `${getMonthLabel(oldest.month).slice(0, 3)} ${oldestYear.year} – ${getMonthLabel(newest.months[0].month).slice(0, 3)} ${newest.year}`;

  const teachers = [
    ...new Set(
      pastEvents
        .map((item) => extractTeacherName(item.story.content.title))
        .filter((name): name is string => Boolean(name))
    ),
  ].slice(0, TEACHERS_NAMED);

  return teachers.length > 0
    ? `${span} · masterclasses with ${teachers.join(', ')}.`
    : `${span}.`;
})();

/** Three upcoming cards close the page, so the archive is not a dead end. */
const CLOSING_CARD_COUNT = 3;
const closingEvents = upcomingEvents.slice(0, CLOSING_CARD_COUNT);

const siteUrl =
  Astro.site?.toString().replace(/\/$/, '') || 'https://singaporehandpans.com';

const seoTitle = 'Past Handpan Classes & Events in Singapore';
const seoDescription =
  'An archive of every handpan workshop, masterclass, concert and community gathering held at Singapore Handpan Studio, grouped by year and month.';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Past Classes & Events',
  url: `${siteUrl}/events/archive/`,
  description: seoDescription,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: pastEvents
      .slice(0, SCHEMA_ITEM_LIMIT)
      .map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${siteUrl}/events/${item.story.slug}/`,
        name: item.story.content.title,
      })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Classes & Events',
      item: `${siteUrl}/events/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Past events',
      item: `${siteUrl}/events/archive/`,
    },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`${Astro.site}events/archive/`}
>
  {
    pastEvents.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(collectionSchema)}
        slot="head"
      />
    )
  }
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
    slot="head"
  />

  <main class="archive-page" id="top">
    {cmsError && <CMSFallback type="events" />}

    <!-- Masthead band wraps the container so its ground and hairline run the
         full width, matching /events/, about, contacts, shop and stories. -->
    <header class="page-header">
      <div class="container">
        <p class="page-eyebrow">
          <a href="/events/">Classes &amp; Events</a>
        </p>
        <h1>Past events</h1>
        <p class="page-subtitle">
          Everything we've run at the studio, newest first. Nothing is taken
          down — browse by month to see what a season at Singapore Handpan
          Studio looks like.
        </p>
      </div>
    </header>

    <div class="container">
      <EventsTabs
        active="past"
        upcomingCount={upcomingEvents.length}
        pastCount={pastEvents.length}
        context={archiveContext}
      />

      {
        jumpTargets.length > 1 && (
          <nav
            class="year-nav"
            aria-label={years.length > 1 ? 'Jump to year' : 'Jump to month'}
          >
            <ul>
              {jumpTargets.map((target) => (
                <li>
                  <a href={`#${target.anchor}`} data-jump-link>
                    {target.label}
                    <span class="year-nav__count">({target.count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        filters.length > 2 && (
          <div class="archive-filters" data-archive-filters>
            <span class="archive-filters__label" id="archive-filter-label">
              Show
            </span>
            <ul aria-labelledby="archive-filter-label">
              {filters.map((filter) => (
                <li>
                  <button
                    type="button"
                    class="archive-filters__chip"
                    data-filter={filter.key}
                    aria-pressed={filter.key === 'all' ? 'true' : 'false'}
                  >
                    {filter.label}
                    <span class="archive-filters__count">{filter.count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        years.map((year) => (
          <section class="archive-year" id={year.anchor} data-archive-year>
            <h2 class="archive-year__heading">
              {year.year}
              <span class="archive-year__count" data-year-count>
                {year.total} {year.total === 1 ? 'event' : 'events'}
              </span>
            </h2>

            {year.months.map((month) => (
              <section
                class="archive-month"
                id={month.anchor}
                data-archive-month
              >
                <h3 class="archive-month__heading">
                  {month.label} {year.year}
                </h3>
                <ul class="past-rows">
                  {month.items.map((item) => (
                    <PastEventRow
                      event={item.story}
                      ranFrom={item.last!.start}
                      ranTo={item.last!.end}
                      runsAgain={runsAgainBySlug.get(item.story.slug) ?? null}
                    />
                  ))}
                </ul>
              </section>
            ))}

            <p class="archive-year__top">
              <a href="#top">&uarr; Back to top</a>
            </p>
          </section>
        ))
      }

      <p class="archive-empty" data-archive-empty hidden>
        Nothing in the archive matches that filter.
      </p>

      {
        closingEvents.length > 0 && (
          <section class="archive-upcoming">
            <h2 class="archive-upcoming__heading">Coming up next</h2>
            <div class="events-grid">
              {closingEvents.map((item) => (
                <EventCard
                  event={item.story}
                  timing={item.timing}
                  next={item.next}
                />
              ))}
            </div>
            <p class="archive-upcoming__more">
              <a href="/events/">See all classes &amp; events &rarr;</a>
            </p>
          </section>
        )
      }

      {
        !cmsError && pastEvents.length === 0 && (
          <section class="no-events">
            <h2>Nothing in the archive yet</h2>
            <p>
              Once our current classes have run, they'll be listed here. See
              what's <a href="/events/">coming up next</a>.
            </p>
          </section>
        )
      }
    </div>
  </main>

  {
    /* The upcoming cards closing this page carry the same booking CTAs and
      availability badges as /events/, so they need the same reconciliation —
      without it the archive could offer a booking link for a sold-out session,
      or show a stale Sold Out for one that has reopened. Past rows emit none
      of the hooks this script looks for, so it ignores them. */
  }
  <script src="../../scripts/availability-hydration.ts"></script>

  <script>
    /**
     * Archive filtering and jump-nav state.
     *
     * One block for both: they read the same sections, and a single
     * DOMContentLoaded keeps the observer from racing a filter pass that has
     * just hidden the section it is observing.
     *
     * Filtering is presentational only — every row stays in the DOM, so the
     * full list is there without JS and for crawlers.
     */
    document.addEventListener('DOMContentLoaded', () => {
      const rows = Array.from(
        document.querySelectorAll<HTMLElement>('[data-past-row]')
      );
      const months = Array.from(
        document.querySelectorAll<HTMLElement>('[data-archive-month]')
      );
      const yearSections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-archive-year]')
      );
      const jumpLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-jump-link]')
      );

      const visible = (element: HTMLElement) => !element.hidden;

      /* ---------- filtering ---------- */

      const filterBar = document.querySelector<HTMLElement>(
        '[data-archive-filters]'
      );
      const emptyNote = document.querySelector<HTMLElement>(
        '[data-archive-empty]'
      );

      const applyFilter = (category: string) => {
        for (const row of rows) {
          row.hidden = category !== 'all' && row.dataset.category !== category;
        }

        // A heading for a month with nothing left in it is a lie, and so is a
        // year total counting rows that are no longer on screen.
        for (const month of months) {
          month.hidden = !month.querySelector<HTMLElement>(
            '[data-past-row]:not([hidden])'
          );
        }

        for (const section of yearSections) {
          const shown = section.querySelectorAll(
            '[data-past-row]:not([hidden])'
          ).length;
          section.hidden = shown === 0;

          const count = section.querySelector<HTMLElement>('[data-year-count]');
          if (count) {
            count.textContent = `${shown} ${shown === 1 ? 'event' : 'events'}`;
          }
        }

        // Jump chips lose their meaning once their section is filtered away.
        // The active mark has to be cleared with them: the observer below only
        // ever *sets* aria-current, so a chip whose section was hidden while it
        // was current would otherwise keep the mark indefinitely.
        for (const link of jumpLinks) {
          const target = document.querySelector<HTMLElement>(
            link.getAttribute('href') ?? ''
          );
          const hidden = Boolean(target?.hidden);
          const listItem = link.closest('li');
          if (listItem) listItem.hidden = hidden;
          if (hidden) link.removeAttribute('aria-current');
        }

        if (emptyNote) emptyNote.hidden = rows.some(visible);

        if (filterBar) {
          for (const chip of filterBar.querySelectorAll<HTMLButtonElement>(
            '[data-filter]'
          )) {
            chip.setAttribute(
              'aria-pressed',
              String(chip.dataset.filter === category)
            );
          }
        }
      };

      const selectFilter = (category: string, pushToUrl: boolean) => {
        applyFilter(category);

        if (!pushToUrl) return;
        // Mirrored to the query string so a filtered view is shareable.
        const url = new URL(window.location.href);
        if (category === 'all') url.searchParams.delete('type');
        else url.searchParams.set('type', category);
        window.history.replaceState({}, '', url);
      };

      if (filterBar) {
        filterBar.addEventListener('click', (event) => {
          const chip = (event.target as HTMLElement).closest<HTMLButtonElement>(
            '[data-filter]'
          );
          if (chip?.dataset.filter) selectFilter(chip.dataset.filter, true);
        });

        const requested = new URL(window.location.href).searchParams.get(
          'type'
        );
        const known = Array.from(
          filterBar.querySelectorAll<HTMLButtonElement>('[data-filter]')
        ).map((chip) => chip.dataset.filter);

        if (requested && known.includes(requested)) {
          selectFilter(requested, false);
        }
      }

      /* ---------- jump-nav active state ---------- */

      if (jumpLinks.length === 0 || !('IntersectionObserver' in window)) return;

      const linkByAnchor = new Map(
        jumpLinks.map((link) => [link.getAttribute('href')!.slice(1), link])
      );
      const targets = Array.from(linkByAnchor.keys())
        .map((id) => document.getElementById(id))
        .filter((element): element is HTMLElement => element !== null);

      const setActive = (anchor: string) => {
        for (const [id, link] of linkByAnchor) {
          if (id === anchor) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      };

      // The top offset clears the sticky bar itself, so a section counts as
      // "current" only once it is actually readable below it.
      const navHeight =
        document.querySelector<HTMLElement>('.year-nav')?.offsetHeight ?? 72;

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(entry.target.id);
          }
        },
        { rootMargin: `-${navHeight}px 0px -70% 0px`, threshold: 0 }
      );

      for (const target of targets) observer.observe(target);
    });
  </script>
</BaseLayout>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .archive-page {
    min-height: calc(100vh - var(--header-height) - var(--footer-height));
    padding: 0 0 var(--spacing-xl);

    // Height of the sticky jump nav. Anchor targets clear this, so the two
    // cannot drift apart the way a duplicated magic number would.
    --archive-nav-height: 4.5rem;
  }

  // Shared masthead treatment, structurally identical to `/events/`: the band
  // wraps `.container` so the ground and hairline run full-bleed.
  .page-header {
    text-align: left;
    background: var(--color-gray-50);
    padding: var(--space-20) 0 var(--space-16);
    margin-bottom: var(--spacing-2xl);
    border-bottom: 1px solid var(--color-hairline);

    @media (min-width: 768px) {
      padding: var(--space-24) 0 var(--space-16);
    }

    h1 {
      font-size: var(--font-size-4xl);
      font-weight: var(--font-weight-light);
      color: var(--color-gray-900);
      margin-bottom: var(--spacing-md);

      @media (min-width: 768px) {
        font-size: var(--font-size-5xl);
      }
    }

    .page-subtitle {
      font-size: var(--font-size-lg);
      color: var(--color-gray-600);
      max-width: 56ch;
      line-height: var(--line-height-relaxed);
    }
  }

  // Bronze is reserved for eyebrows, links and hairlines.
  .page-eyebrow {
    margin-bottom: var(--spacing-sm);
    font-size: var(--font-size-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;

    a {
      color: var(--color-primary);
      text-decoration: none;

      &:hover,
      &:focus-visible {
        text-decoration: underline;
      }
    }
  }

  // Sticky so the month you are reading is always one tap away on a long
  // scroll. Pinned to 0, not to --header-height: the site header is declared
  // sticky but sits inside .page-wrapper, where sticky never engages, so it
  // scrolls away. Offsetting by its height would leave a 76px window of page
  // content scrolling above this bar.
  .year-nav {
    position: sticky;
    top: 0;
    z-index: 2;
    margin-bottom: var(--spacing-xl);
    padding: var(--spacing-sm) 0;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-hairline);

    ul {
      display: flex;
      gap: var(--spacing-md);
      margin: 0;
      padding: 0;
      list-style: none;
      overflow-x: auto;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }

    a {
      display: inline-flex;
      align-items: baseline;
      gap: var(--spacing-xs);
      padding: var(--spacing-xs) var(--spacing-sm);
      border: 1px solid var(--color-border);
      border-radius: var(--border-radius-sm);
      color: var(--color-text-primary);
      text-decoration: none;
      white-space: nowrap;
      transition:
        border-color var(--transition-fast),
        color var(--transition-fast);

      &:hover,
      &:focus-visible {
        border-color: var(--color-primary);
        color: var(--color-primary);
      }

      // Set by the IntersectionObserver as you scroll — the bar was stateless
      // through eleven screens.
      &[aria-current='true'] {
        border-color: var(--color-primary);
        color: var(--color-primary);
      }
    }
  }

  // Parenthesised and set in mono, because "August 1" parsed as a date on
  // every chip. It is a count.
  .year-nav__count {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
  }

  // Sits beside the month jump nav. "Show me the concerts" is what an archive
  // gets asked, and reading 32 rows in date order was the only answer.
  .archive-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-xl);

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  .archive-filters__label {
    font-size: var(--font-size-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .archive-filters__chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background: transparent;
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: var(--font-size-sm);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);

    &:hover,
    &:focus-visible {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    &[aria-pressed='true'] {
      background: var(--color-gray-900);
      border-color: var(--color-gray-900);
      color: var(--color-white);
    }
  }

  .archive-filters__count {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    color: inherit;
    opacity: 0.7;
  }

  .archive-year {
    margin-bottom: var(--spacing-2xl);
    // Clears the sticky header + year nav when jumped to via an anchor.
    scroll-margin-top: calc(var(--archive-nav-height) + var(--spacing-md));
  }

  .archive-year__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-light);
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-accent);
  }

  .archive-year__count {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .archive-month {
    margin-bottom: var(--spacing-xl);
    scroll-margin-top: calc(var(--archive-nav-height) + var(--spacing-md));
  }

  .archive-month__heading {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-md);
  }

  // Past events are rows now, not cards — see `PastEventRow`. The grid below
  // is only for the upcoming cards that close the page.
  .past-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    overflow: hidden;
  }

  .archive-year__top {
    margin-top: var(--spacing-lg);
    font-size: var(--font-size-sm);

    a {
      color: var(--color-text-secondary);
      text-decoration: none;

      &:hover,
      &:focus-visible {
        color: var(--color-primary);
        text-decoration: underline;
      }
    }
  }

  .archive-empty {
    padding: var(--spacing-xl) 0;
    color: var(--color-text-secondary);
