---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetail from '../../components/EventDetail.astro';
import { getStoryblokClient } from '../../lib/storyblok';
import { setEdgeCache } from '../../lib/edgeCache';
import {
  getClassAvailability,
  computeAvailabilityStatus,
  resolveSlotAvailability,
} from '../../lib/acuity-client';
import {
  getEventTiming,
  getNextOccurrence,
  getSingaporeParts,
  toSingaporeIso,
} from '../../lib/eventDates';
import { parsePrice } from '../../lib/eventFormat';
import type { EventStory } from '../../types/event';

export const prerender = false;
setEdgeCache(Astro.response, 'medium');

const PRICE_CURRENCY = 'SGD';

const { slug } = Astro.params;

let event: EventStory | undefined;

try {
  const runtime = Astro.locals.runtime;
  const token =
    runtime?.env?.STORYBLOK_TOKEN ?? import.meta.env.STORYBLOK_TOKEN;
  const storyblokApi = getStoryblokClient(token);
  const storyblokVersion = import.meta.env.PROD ? 'published' : 'draft';

  const { data } = await storyblokApi.get(`cdn/stories/events/${slug}`, {
    version: storyblokVersion,
  });

  event = data?.story;
} catch (error) {
  console.error('Event [slug]: Failed to load from Storyblok', error);
}

if (!event) {
  return Astro.redirect('/events');
}

const now = new Date();
// Anchored to Singapore rather than the runtime zone. `event.content.date` is a
// naive 'YYYY-MM-DD HH:mm' string, so it used to be emitted verbatim as
// `startDate` — not valid ISO-8601, which schema.org silently rejects.
const timing = getEventTiming(event.content);
// A series advertises its next session; a finished one falls back to its first.
const occurrence = timing
  ? (getNextOccurrence(timing, now) ?? { start: timing.start, end: timing.end })
  : null;

/**
 * Live availability for the session this page advertises.
 *
 * The story's own `availability_status` is refreshed by a webhook keyed on the
 * first instance's Acuity class id, so for a recurring series it describes a
 * session that has already run. Resolving the advertised occurrence here means
 * the page neither hides booking for an open class nor offers a full one.
 *
 * Best-effort: any failure returns null and the component falls back.
 */
async function resolveLiveAvailability(
  content: EventStory['content']
): Promise<'available' | 'few_spots' | 'sold_out' | null> {
  const appointmentTypeId = content.acuity_appointment_type_id;
  if (!appointmentTypeId || !occurrence) return null;

  try {
    const startIso = toSingaporeIso(occurrence.start);
    const slots = await getClassAvailability(
      appointmentTypeId,
      startIso.slice(0, 7)
    );
    const seats = resolveSlotAvailability(slots, {
      // Only a one-off can trust its stored instance id.
      classId:
        timing?.recurrence === 'none' ? content.acuity_class_id : undefined,
      time: startIso,
    });
    return seats === null ? null : computeAvailabilityStatus(seats);
  } catch (error) {
    console.error('Event [slug]: availability lookup failed', error);
    return null;
  }
}

const liveAvailability = await resolveLiveAvailability(event.content);

// Same precedence the detail component applies, so the page and its structured
// data can never disagree about whether the session is bookable.
const offerAvailability =
  liveAvailability ??
  (timing && timing.recurrence !== 'none'
    ? undefined
    : event.content.availability_status);

const RECURRENCE_FREQUENCY: Record<string, string> = {
  weekly: 'P1W',
  biweekly: 'P2W',
  monthly: 'P1M',
};
/** Highest day-of-month present in every month, so `byMonthDay` never lies. */
const SAFE_MONTH_DAY = 28;

const SCHEMA_WEEKDAYS = [
  'Sunday',
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
];

const eventSchedule =
  timing && timing.recurrence !== 'none'
    ? {
        '@type': 'Schedule',
        repeatFrequency: RECURRENCE_FREQUENCY[timing.recurrence],
        // A monthly series repeats on the calendar day, not the weekday, so
        // byDay would advertise a different rule than the site applies.
        //
        // byMonthDay is only emitted for days 1-28, which exist in every month.
        // From the 29th on, `expandOccurrences` clamps to the month's last day
        // (31 Jan -> 28 Feb), and `byMonthDay: 31` cannot express that — it
        // would claim a February session that the rule itself excludes. Those
        // series fall back to repeatFrequency plus the start/end window, which
        // is less precise but true.
        ...(timing.recurrence === 'monthly'
          ? getSingaporeParts(timing.start).day <= SAFE_MONTH_DAY
            ? { byMonthDay: getSingaporeParts(timing.start).day }
            : {}
          : {
              byDay: `https://schema.org/${SCHEMA_WEEKDAYS[getSingaporeParts(timing.start).weekday]}`,
            }),
        startDate: toSingaporeIso(timing.start).slice(0, 10),
        ...(timing.recurrenceUntil
          ? { endDate: toSingaporeIso(timing.recurrenceUntil).slice(0, 10) }
          : {}),
        startTime: toSingaporeIso(timing.start).slice(11, 16),
        endTime: toSingaporeIso(timing.end).slice(11, 16),
        scheduleTimezone: 'Asia/Singapore',
      }
    : undefined;

// Parsed, not stripped. `replace(/[^0-9.]/g, '')` turned the range "$38-$138"
// into "38138" — an Offer.price of thirty-eight thousand. A range is published
// as a priceSpecification; an unparseable price is omitted rather than guessed.
const parsedPrice = parsePrice(event.content.price);

const priceOffer = parsedPrice
  ? parsedPrice.max !== null
    ? {
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: parsedPrice.min,
          maxPrice: parsedPrice.max,
          priceCurrency: PRICE_CURRENCY,
        },
      }
    : { price: String(parsedPrice.min), priceCurrency: PRICE_CURRENCY }
  : null;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.content.title,
  description: event.content.description,
  startDate: occurrence ? toSingaporeIso(occurrence.start) : undefined,
  // Previously a hardcoded start + 2h, which ignored both `duration` and any
  // multi-day span.
  endDate: occurrence ? toSingaporeIso(occurrence.end) : undefined,
  ...(eventSchedule ? { eventSchedule } : {}),
  location: {
    '@type': 'Place',
    name: event.content.location,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Singapore',
      addressCountry: 'SG',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Singapore Handpan Studio',
    url: Astro.site?.toString(),
  },
  offers: priceOffer
    ? {
        '@type': 'Offer',
        ...priceOffer,
        // Describes the advertised session, matching what the page renders: the
        // live lookup when there is one, otherwise the story's own value —
        // except for a series, where that value refers to a session that has
        // already run.
        availability:
          event.content.sold_out_override || offerAvailability === 'sold_out'
            ? 'https://schema.org/SoldOut'
            : offerAvailability === 'few_spots'
              ? 'https://schema.org/LimitedAvailability'
              : 'https://schema.org/InStock',
        url: event.content.booking_url || `${Astro.site}events/${event.slug}`,
      }
    : undefined,
  image: event.content.image?.filename,
  // `status` is otherwise unmaintained (every story reads 'upcoming'), so only
  // the explicit 'cancelled' value is honoured here.
  eventStatus:
    event.content.status === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
};

const seoTitle =
  event.content.seo_title ||
  `${event.content.title} - Singapore Handpan Studio`;
const seoDescription =
  event.content.seo_description || event.content.description;

const siteUrl =
  Astro.site?.toString().replace(/\/$/, '') || 'https://singaporehandpans.com';
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Classes',
      item: `${siteUrl}/events/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: event.content.title,
      item: `${siteUrl}/events/${event.slug}/`,
    },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`${Astro.site}events/${event.slug}/`}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbData)}
    slot="head"
  />
  <main class="event-detail-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="separator">›</span>
        <a href="/events/">Classes</a>
        <span class="separator">›</span>
        <span class="current">{event.content.title}</span>
      </nav>

      <EventDetail event={event} liveAvailability={liveAvailability} />
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .event-detail-page {
    min-height: calc(100vh - var(--header-height) - var(--footer-height));
    padding: var(--spacing-lg) 0;
  }
  // `.container` comes from global.scss — see events.astro.

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xl);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);

    a {
      color: var(--color-primary);
      text-decoration: none;
      // The site's link pattern: a 1px rule that fades in, not a browser
      // underline that snaps. See FeaturedProducts `__view-all`.
      border-bottom: 1px solid transparent;
      transition:
        color var(--transition-fast),
        border-color var(--transition-fast);

      &:hover {
        color: var(--color-primary-dark);
        border-bottom-color: var(--color-primary-dark);
      }
    }

    .separator {
      color: var(--color-text-tertiary);
    }

    .current {
      color: var(--color-text-primary);
      font-weight: var(--font-weight-medium);
    }
  }

  @media (max-width: 768px) {
    .breadcrumb {
      flex-wrap: wrap;
      gap: var(--spacing-xs);

      .current {
        flex: 1 0 100%;
        margin-top: var(--spacing-xs);
      }
    }
  }
</style>
