---
import BaseLayout from '../layouts/BaseLayout.astro';

const seoTitle = 'Handpan Academy — Free Learning Resources & Tools';
const seoDescription =
  'Free handpan learning resources — interactive chord explorer, scale guides, and practice tools for handpan players of all levels. Start learning handpan today.';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`${Astro.site}academy/`}
>
  <main class="academy-page">
    <div class="container">
      <section class="academy-hero">
        <h1 class="academy-hero__title">Handpan Academy</h1>
        <p class="academy-hero__description">
          Welcome to our comprehensive handpan learning center. Explore
          interactive tools, tutorials, and resources designed to help you
          master the handpan at every level.
        </p>
      </section>

      <section class="academy-tools">
        <div class="tool-card">
          <div class="tool-card__icon">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </div>
          <h2 class="tool-card__title">Handpan Chord Explorer</h2>
          <p class="tool-card__description">
            Your go-to practice companion for quick chord lookups and note
            visualization. Instantly see which notes make up any chord and where
            they sit on your handpan. Great for both learning new chords and
            refreshing your memory during practice.
          </p>
          <a href="/academy/memorization/" class="tool-card__link">
            Explore Tool
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div class="coming-soon-card">
          <div class="coming-soon-card__icon">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
          </div>
          <h2 class="coming-soon-card__title">More Tools Coming Soon</h2>
          <p class="coming-soon-card__description">
            We're continuously developing new learning resources including
            rhythm exercises, technique tutorials, and advanced practice tools.
            Stay tuned for updates!
          </p>
        </div>
      </section>

      <section class="academy-about">
        <h2 class="academy-about__title">Learn the Handpan in Singapore</h2>
        <p>
          The handpan is one of the most approachable instruments to begin with
          — no musical background is required, and its intuitive layout means
          you can play your first melody within minutes. Our academy brings
          together free online tools and hands-on teaching so you can learn
          handpan at your own pace, whether you are a complete beginner or an
          advancing player refining technique and repertoire.
        </p>
        <p>
          Prefer to learn in person? Singapore Handpan Studio runs
          beginner-friendly handpan lessons, private and group classes,
          workshops and masterclasses out of our studio. Pair the Chord Explorer
          above with a class to move from understanding scales and chords to
          confidently improvising your own music.
        </p>
        <div class="academy-about__cta">
          <a href="/events/" class="academy-about__link">
            Browse handpan classes &amp; events
          </a>
          <a
            href="/contacts/"
            class="academy-about__link academy-about__link--secondary"
          >
            Book a lesson
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  .academy-page {
    min-height: calc(100vh - var(--header-height) - var(--footer-height));
    padding: var(--spacing-2xl) 0;
    background: var(--color-gray-50);
  }

  .academy-hero {
    text-align: center;
    padding: var(--spacing-2xl) 0 var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
  }

  .academy-hero__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    margin-bottom: var(--spacing-lg);
    font-family: var(--font-family-heading);
  }

  .academy-hero__description {
    font-size: var(--font-size-xl);
    color: var(--color-text-secondary);
    max-width: 800px;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  .academy-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
  }

  .tool-card {
    background: var(--color-white);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-base);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;

    &:hover {
      box-shadow: 0 0 0 1px var(--color-primary-light);
    }

    &__icon {
      color: var(--color-primary);
      margin-bottom: var(--spacing-lg);
    }

    &__title {
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      color: var(--color-text-primary);
      margin-bottom: var(--spacing-md);
      font-family: var(--font-family-heading);
    }

    &__description {
      font-size: var(--font-size-base);
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
      margin-bottom: var(--spacing-lg);
      flex-grow: 1;
    }

    &__link {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-sm);
      padding: var(--spacing-md) var(--spacing-lg);
      background: var(--color-gray-900);
      color: var(--color-white);
      text-decoration: none;
      border-radius: var(--border-radius-md);
      font-weight: var(--font-weight-semibold);
      transition: all var(--transition-base);
      width: fit-content;

      &:hover {
        background: var(--color-gray-800);
        transform: translateX(4px);
      }

      svg {
        transition: transform var(--transition-base);
      }

      &:hover svg {
        transform: translateX(2px);
      }
    }
  }

  .academy-about {
    max-width: 800px;
    margin: 0 auto var(--spacing-2xl);
    text-align: center;

    &__title {
      font-size: var(--font-size-3xl);
      font-weight: var(--font-weight-bold);
      color: var(--color-text-primary);
      margin-bottom: var(--spacing-lg);
      font-family: var(--font-family-heading);
    }

    p {
      font-size: var(--font-size-base);
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
      margin-bottom: var(--spacing-md);
    }

    &__cta {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--spacing-lg);
    }

    &__link {
      display: inline-flex;
      align-items: center;
      padding: var(--spacing-md) var(--spacing-lg);
      background: var(--color-gray-900);
      color: var(--color-white);
      text-decoration: none;
      border-radius: var(--border-radius-md);
      font-weight: var(--font-weight-semibold);
      transition: all var(--transition-base);

      &:hover {
        background: var(--color-gray-800);
      }

      &--secondary {
        background: transparent;
        color: var(--color-primary);
        border: 2px solid var(--color-primary);

        &:hover {
          background: var(--color-gray-900);
          color: var(--color-white);
        }
      }
    }
  }

  .coming-soon-card {
    background: var(--color-white);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-base);
    display: flex;
    flex-direction: column;
    opacity: 0.8;
    border: 2px dashed var(--color-gray-300);

    &__icon {
      color: var(--color-gray-400);
      margin-bottom: var(--spacing-lg);
    }

    &__title {
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      color: var(--color-text-secondary);
      margin-bottom: var(--spacing-md);
      font-family: var(--font-family-heading);
    }

    &__description {
      font-size: var(--font-size-base);
      color: var(--color-text-secondary);
      line-height: var(--line-height-relaxed);
    }
  }

  @media (max-width: 768px) {
    .academy-hero__title {
      font-size: var(--font-size-3xl);
    }

    .academy-hero__description {
      font-size: var(--font-size-lg);
    }

    .academy-tools {
      grid-template-columns: 1fr;
    }
  }
</style>
