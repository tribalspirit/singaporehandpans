---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  STUDIO_NAME,
  STUDIO_EMAIL,
  STUDIO_ADDRESS,
} from '../constants/contacts';

const title = 'Terms of Service';
const description =
  'Terms and conditions for using Singapore Handpan Studio services and website.';
const lastUpdated = 'November 25, 2026';
// The version of section 19.3, "Licence for published tunes"
// (#tab-editor-licence). The Handpan Tab Editor records this date, as
// YYYY-MM-DD, as its TERMS_VERSION on every submission. Change it whenever
// that sub-section's words change, and tell the tab editor the new date.
const tabEditorLicenceVersion = {
  iso: '2026-11-25',
  label: 'November 25, 2026',
} as const;
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${Astro.site}terms/`}
  noindex
>
  <div class="legal-page">
    <div class="container">
      <div class="legal-content">
        <h1 class="legal-title">Terms of Service</h1>
        <p class="legal-meta">Last Updated: {lastUpdated}</p>

        <div class="legal-intro">
          <p>
            Welcome to {STUDIO_NAME}. By accessing our website or using our
            services, you agree to be bound by these Terms of Service. Please
            read them carefully. If you do not agree with any part of these
            terms, you may not use our services.
          </p>
        </div>

        <section class="legal-section">
          <h2>1. Acceptance of Terms</h2>
          <p>
            These Terms of Service ("Terms") constitute a legally binding
            agreement between you and
            {STUDIO_NAME} ("Studio," "we," "us," or "our"). By accessing our website,
            booking classes, attending events, or using any of our services, you acknowledge
            that you have read, understood, and agree to be bound by these Terms and
            our Privacy Policy.
          </p>
        </section>

        <section class="legal-section">
          <h2>2. Services</h2>
          <p>{STUDIO_NAME} provides:</p>
          <ul>
            <li>Handpan lessons and workshops (group and private sessions)</li>
            <li>Community events and performances</li>
            <li>Educational resources through our Academy platform</li>
            <li>Instrument rental and sales assistance</li>
            <li>Studio space rental</li>
          </ul>
          <p>
            We reserve the right to modify, suspend, or discontinue any aspect
            of our services at any time without notice.
          </p>
        </section>

        <section class="legal-section">
          <h2>3. User Eligibility</h2>
          <p>
            Our services are available to individuals aged 13 and older. If you
            are under 18 years of age, you may only use our services with the
            involvement and consent of a parent or legal guardian. By using our
            services, you represent and warrant that you meet these eligibility
            requirements.
          </p>
        </section>

        <section class="legal-section">
          <h2>4. Registration and Account</h2>
          <p>
            When you register for classes or create an account, you agree to
            provide accurate, current, and complete information. You are
            responsible for maintaining the confidentiality of your account
            credentials and for all activities that occur under your account.
            You must notify us immediately of any unauthorized use of your
            account.
          </p>
        </section>

        <section class="legal-section">
          <h2>5. Bookings and Payments</h2>

          <h3>5.1 Class and Workshop Bookings</h3>
          <ul>
            <li>
              All bookings must be made through our official website or approved
              booking platforms
            </li>
            <li>
              Payment is required in full at the time of booking unless
              otherwise specified
            </li>
            <li>
              Prices are subject to change without notice, but confirmed
              bookings honor the original price
            </li>
            <li>
              We accept payment methods as displayed during the booking process
            </li>
          </ul>

          <h3>5.2 Cancellation and Refund Policy</h3>
          <ul>
            <li>
              <strong>Student Cancellations:</strong> Cancellations made 48 hours
              or more before the scheduled session are eligible for a full refund
              or credit toward future sessions
            </li>
            <li>
              <strong>Late Cancellations:</strong> Cancellations made less than 48
              hours before the session may forfeit 50% of the payment
            </li>
            <li>
              <strong>No-Shows:</strong> Failure to attend a booked session without
              prior notice will result in forfeiture of the full payment
            </li>
            <li>
              <strong>Studio Cancellations:</strong> If we need to cancel a session,
              you will receive a full refund or the option to reschedule
            </li>
          </ul>

          <h3>5.3 Rescheduling</h3>
          <p>
            Requests to reschedule must be made at least 24 hours in advance. We
            will make reasonable efforts to accommodate rescheduling requests,
            subject to instructor availability.
          </p>
        </section>

        <section class="legal-section">
          <h2>6. Studio Rules and Conduct</h2>
          <p>
            When participating in our classes, workshops, or events, you agree
            to:
          </p>
          <ul>
            <li>Arrive on time for scheduled sessions</li>
            <li>
              Treat instructors, staff, and other participants with respect
            </li>
            <li>
              Follow all safety guidelines and instructions provided by
              instructors
            </li>
            <li>Handle instruments and equipment with care</li>
            <li>Keep the studio space clean and organized</li>
            <li>
              Not engage in disruptive, offensive, or inappropriate behavior
            </li>
            <li>Respect the privacy of other participants</li>
          </ul>
          <p>
            We reserve the right to refuse service or remove any individual who
            violates these rules or engages in conduct that we deem
            inappropriate or harmful to our community.
          </p>
        </section>

        <section class="legal-section">
          <h2>7. Instruments and Equipment</h2>

          <h3>7.1 Studio Instruments</h3>
          <p>
            Handpans and other instruments provided by the studio during lessons
            are for educational purposes only. You are responsible for any
            damage to instruments or equipment caused by negligence or misuse.
            Repair or replacement costs may be charged to you.
          </p>

          <h3>7.2 Personal Instruments</h3>
          <p>
            If you bring your own instruments to the studio, you do so at your
            own risk. We are not responsible for loss, theft, or damage to
            personal instruments or belongings.
          </p>
        </section>

        <section class="legal-section">
          <h2>8. Intellectual Property</h2>

          <h3>8.1 Our Content</h3>
          <p>
            All content on our website and in our educational materials,
            including text, graphics, logos, images, audio clips, video clips,
            and software, is the property of {STUDIO_NAME} or our content suppliers
            and is protected by copyright, trademark, and other intellectual property
            laws.
          </p>

          <h3>8.2 Limited License</h3>
          <p>
            We grant you a limited, non-exclusive, non-transferable license to
            access and use our website and educational materials for personal,
            non-commercial purposes. You may not:
          </p>
          <ul>
            <li>
              Reproduce, distribute, or publicly display our content without
              permission
            </li>
            <li>Modify or create derivative works based on our content</li>
            <li>Use our content for commercial purposes</li>
            <li>Remove copyright or proprietary notices</li>
          </ul>

          <h3>8.3 User-Generated Content</h3>
          <p>
            If you submit photos, videos, testimonials, or other content to us,
            you grant us a worldwide, royalty-free, perpetual license to use,
            reproduce, and display such content for promotional and marketing
            purposes.
          </p>
        </section>

        <section class="legal-section">
          <h2>9. Photography and Recording</h2>
          <p>
            We may take photographs or videos during classes and events for
            promotional purposes. By participating, you consent to being
            photographed or recorded and to our use of such media in marketing
            materials. If you prefer not to be photographed, please inform us in
            advance.
          </p>
        </section>

        <section class="legal-section">
          <h2>10. Health and Safety</h2>

          <h3>10.1 Physical Activity</h3>
          <p>
            While handpan playing is generally a low-impact activity, it does
            involve physical movement and repetitive motions. You should consult
            with a healthcare provider before participating if you have any
            health concerns or physical limitations.
          </p>

          <h3>10.2 Medical Conditions</h3>
          <p>
            You are responsible for informing us of any medical conditions,
            injuries, or limitations that may affect your ability to participate
            safely in our programs.
          </p>

          <h3>10.3 COVID-19 and Health Protocols</h3>
          <p>
            We follow applicable health and safety guidelines. By attending
            in-person sessions, you acknowledge and accept the inherent risks of
            potential exposure to illness.
          </p>
        </section>

        <section class="legal-section">
          <h2>11. Limitation of Liability</h2>
          <p>
            To the fullest extent permitted by law, {STUDIO_NAME} and its instructors,
            employees, and affiliates shall not be liable for any indirect, incidental,
            special, consequential, or punitive damages, or any loss of profits or
            revenues, whether incurred directly or indirectly, or any loss of data,
            use, goodwill, or other intangible losses resulting from:
          </p>
          <ul>
            <li>Your use or inability to use our services</li>
            <li>
              Any unauthorized access to or use of our servers and/or personal
              information
            </li>
            <li>Any interruption or cessation of services</li>
            <li>
              Any bugs, viruses, or other harmful code that may be transmitted
              through our services
            </li>
            <li>Any errors or omissions in content or materials</li>
            <li>Any injury or damage to persons or property</li>
          </ul>
          <p>
            Our total liability to you for all claims arising from your use of
            our services shall not exceed the amount you paid to us in the six
            months prior to the claim.
          </p>
        </section>

        <section class="legal-section">
          <h2>12. Indemnification</h2>
          <p>
            You agree to indemnify, defend, and hold harmless {STUDIO_NAME} and its
            officers, directors, employees, contractors, and agents from any claims,
            liabilities, damages, losses, costs, expenses, or fees (including reasonable
            attorneys' fees) arising from:
          </p>
          <ul>
            <li>Your use of our services</li>
            <li>Your violation of these Terms</li>
            <li>Your violation of any rights of another person or entity</li>
            <li>Your conduct in connection with our services</li>
          </ul>
        </section>

        <section class="legal-section">
          <h2>13. Disclaimer of Warranties</h2>
          <p>
            Our services are provided "as is" and "as available" without
            warranties of any kind, either express or implied, including but not
            limited to warranties of merchantability, fitness for a particular
            purpose, or non-infringement. We do not warrant that our services
            will be uninterrupted, error-free, or free of viruses or other
            harmful components.
          </p>
        </section>

        <section class="legal-section">
          <h2>14. Links to Third-Party Websites</h2>
          <p>
            Our website may contain links to third-party websites (such as
            Acuity Scheduling, social media platforms, or payment processors)
            for your convenience. We do not control and are not responsible for
            the content, privacy policies, or practices of any third-party
            websites. Your use of third-party websites is at your own risk.
          </p>
        </section>

        <section class="legal-section">
          <h2>15. Dispute Resolution</h2>

          <h3>15.1 Governing Law</h3>
          <p>
            These Terms shall be governed by and construed in accordance with
            the laws of Singapore, without regard to its conflict of law
            provisions.
          </p>

          <h3>15.2 Dispute Resolution Process</h3>
          <p>
            In the event of any dispute arising from these Terms or your use of
            our services, you agree to first contact us to attempt to resolve
            the dispute informally. If we cannot resolve the dispute within 30
            days, the dispute shall be submitted to mediation in Singapore
            before resorting to litigation.
          </p>

          <h3>15.3 Jurisdiction</h3>
          <p>
            You agree that any legal action or proceeding shall be brought
            exclusively in the courts of Singapore, and you consent to the
            personal jurisdiction of such courts.
          </p>
        </section>

        <section class="legal-section">
          <h2>16. Modifications to Terms</h2>
          <p>
            We reserve the right to modify these Terms at any time. We will
            notify you of any material changes by posting the new Terms on our
            website and updating the "Last Updated" date. Your continued use of
            our services after such changes constitutes your acceptance of the
            modified Terms.
          </p>
        </section>

        <section class="legal-section">
          <h2>17. Severability</h2>
          <p>
            If any provision of these Terms is found to be invalid or
            unenforceable, that provision shall be limited or eliminated to the
            minimum extent necessary, and the remaining provisions shall remain
            in full force and effect.
          </p>
        </section>

        <section class="legal-section">
          <h2>18. Entire Agreement</h2>
          <p>
            These Terms, together with our Privacy Policy, constitute the entire
            agreement between you and
            {STUDIO_NAME} regarding your use of our services and supersede all prior
            agreements and understandings.
          </p>
        </section>

        <section class="legal-section">
          <h2 id="tab-editor">19. Handpan Tab Editor</h2>
          <p>
            This section applies to the Handpan Tab Editor ("the editor"), run
            by the Studio. The rest of these Terms apply to the editor too,
            including User Eligibility (section 3), Limitation of Liability
            (11), Disclaimer of Warranties (13), Dispute Resolution (15) and
            Modifications to Terms (16). Where this section says something
            different about the editor, this section applies. In particular,
            <a href="#tab-editor-licence">"Licence for published tunes"</a> below
            applies to tunes in place of section 8.3, and "What listeners may do"
            applies to published tunes in place of section 8.2.
          </p>

          <h3>19.1 Using the editor</h3>
          <p>The editor is free to use.</p>
          <ul>
            <li>
              <strong>No account needed to listen.</strong> Anyone may browse and
              play the tune library, shared tune links and embedded tunes.
            </li>
            <li>
              <strong>An account to write.</strong> To write or edit tunes you need
              an account. You sign in with a link we email you, and each email address
              has one account. Anyone who can open your email can sign in as you,
              so keep your email account secure.
            </li>
            <li>
              <strong>Eligibility.</strong> Section 3 applies: you must be 13 or older,
              and if you are under 18 you need a parent's or guardian's consent.
            </li>
            <li>
              <strong>Your display name.</strong> It is shown publicly as the author
              of the tunes you submit. Don't use a name that pretends to be someone
              else.
            </li>
            <li>
              <strong>Beta.</strong> The editor is in beta. Its features and limits
              may change.
            </li>
            <li>
              <strong>Limits.</strong> An account holds up to 200 tunes, and 25 MiB
              in total. One tune can be up to 128 KiB. Up to 10 of your tunes can
              be in review at once. A note to the reviewer can be up to 1,000 characters,
              and a display name 1 to 60 characters. Each address gets up to 5 sign-in
              emails a day.
            </li>
            <li>
              <strong>Keep your own copies.</strong> Save important tunes with
              <strong>Save .hptab</strong> in the File menu.
            </li>
          </ul>

          <h3>19.2 Publishing a tune</h3>
          <ul>
            <li>
              <strong>Submitting.</strong> You submit a tune from the editor or from
              My tunes. You choose its difficulty and moods, can add a note to the
              reviewer, and agree to the licence below.
            </li>
            <li>
              <strong>Review.</strong> An admin reviews your tune. They either confirm
              or change its difficulty and moods and publish it, credited to your
              display name as it was when you submitted, or decline it with a note
              you'll see in My tunes. You can submit again. Admins may decline any
              submission.
            </li>
            <li>
              <strong>Once published,</strong> the tune has its own public address.
              It can be read through the library, the embedded player and the editor's
              public API, which needs no sign-in and which the Studio's website uses.
            </li>
            <li>
              <strong>Changes</strong> you make after publishing go through review
              again. Once approved, they become the tune's new version, at the same
              address.
            </li>
            <li>
              <strong>Unlisting.</strong> You can unlist your own published tune and
              list it again. An admin can unlist any tune. If an admin has unlisted
              your tune, it stays unlisted until an admin lists it again, even if
              you list it again yourself.
            </li>
            <li>
              <strong>Removing a tune.</strong> Deleting a tune from My tunes doesn't
              remove its published copy. Deleting your account removes every tune
              published from it.
            </li>
          </ul>

          <h3 id="tab-editor-licence">19.3 Licence for published tunes</h3>
          <p>
            <strong>You keep your rights.</strong> You keep the copyright and any
            other rights you have in your tune. This licence doesn't transfer them
            to us.
          </p>
          <p>
            <strong>What you allow us to do.</strong> When you submit a tune and it
            is published, you give the Studio a worldwide, non-exclusive, royalty-free
            licence to:
          </p>
          <ul>
            <li>
              publish, store, display and play the tune, and make it available
              through the editor's library, its embedded player and its public
              API, including on the Studio's own website;
            </li>
            <li>
              make the technical changes publishing needs:
              <ul>
                <li>crediting the tune to your display name;</li>
                <li>giving it its own public address;</li>
                <li>removing data the tune format doesn't use;</li>
                <li>
                  showing details worked out from the tune, such as its length
                  and the techniques it uses, alongside the difficulty and moods
                  an admin confirms;
                </li>
              </ul>
            </li>
            <li>
              publish edited versions of the tune, credited to you and marked
              "edited by the library". If you then submit changes and they are
              approved, your version replaces the library's;
            </li>
            <li>
              keep earlier versions of the tune with it while it is published;
            </li>
            <li>
              let people use the tune as "What listeners may do" describes.
            </li>
          </ul>
          <p>
            The licence is non-exclusive, so you remain free to share your tune
            anywhere else as well.
          </p>
          <p>
            <strong>Your promise.</strong> By submitting a tune, you confirm that
            it is yours to share this way: either you wrote it, or you have the rights
            or permission it needs. This includes arrangements of other people's songs:
            submit one only if the song is in the public domain or you have permission
            to share an arrangement of it.
          </p>
          <p>
            <strong>What listeners may do.</strong> Anyone may view and play a published
            tune in the library and through the embedded player, and share its link.
            Anyone signed in may also open a copy in the editor ("Edit a copy"), keep
            it in their own My tunes, and save it as a file. They may do this for
            their own practice and study, not for any commercial purpose. Listeners
            may not:
          </p>
          <ul>
            <li>sell a published tune, or use it commercially;</li>
            <li>
              republish or redistribute it, or edited copies of it, outside the
              library and the embedded player;
            </li>
            <li>remove or change its credit.</li>
          </ul>
          <p>When listeners share or mention a tune, they credit its author.</p>
          <p>
            <strong>Unlisting.</strong> If you or an admin unlist a published tune,
            it leaves the library's list and search. It still opens by its link, and
            it keeps playing wherever it is embedded. This licence continues for as
            long as the tune can be opened that way.
          </p>
          <p>
            <strong>When the licence ends.</strong> The licence ends when the tune
            leaves the library. That happens when your account is deleted: by you,
            or by us at your request if your account is banned. From then:
          </p>
          <ul>
            <li>
              the editor stops serving the tune, and embeds of it stop playing;
            </li>
            <li>
              copies already fetched may still appear briefly. Browsers and
              caches may reuse the tune's file for up to 5 minutes and its
              listing for up to 1 minute, and a page that already has the tune
              open keeps it until it is closed or reloaded;
            </li>
            <li>
              copies other people opened into their own My tunes, or saved as
              files, before then stay with them, and they may go on using them
              under "What listeners may do";
            </li>
            <li>
              records of admin actions that name the tune's internal id remain,
              holding none of its content.
            </li>
          </ul>
          <p>
            <strong>Which version of these terms applies.</strong> Each submission
            records the version of these terms that was in force when you submitted
            it. A published tune keeps the version that applied when it was last approved.
            If we change this licence, the change applies to tunes submitted after
            the change. This version is dated <time
              datetime={tabEditorLicenceVersion.iso}
              >{tabEditorLicenceVersion.label}</time
            >.
          </p>

          <h3>19.4 Bans</h3>
          <p>
            An admin may ban an account for submitting tunes you have no right
            to share, for pretending to be someone else, or for misusing the
            editor or other people's accounts. A banned account is signed out
            everywhere and can't sign in. Its tunes stay until an admin unlists
            or declines them. If your account is banned and you want it deleted,
            ask us and an admin will delete it.
          </p>

          <h3>19.5 Contact</h3>
          <p>
            For questions about the editor, or if you believe a published tune
            infringes your rights, contact us at <a
              href={`mailto:${STUDIO_EMAIL}`}>{STUDIO_EMAIL}</a
            >.
          </p>
        </section>

        <section class="legal-section">
          <h2>20. Contact Information</h2>
          <p>
            If you have any questions or concerns about these Terms of Service,
            please contact us:
          </p>
          <div class="contact-info">
            <p><strong>{STUDIO_NAME}</strong></p>
            <p>{STUDIO_ADDRESS}</p>
            <p>Email: <a href={`mailto:${STUDIO_EMAIL}`}>{STUDIO_EMAIL}</a></p>
            <p>Phone: +65 9088 6848</p>
          </div>
        </section>

        <div class="legal-footer">
          <p>
            By using our website and services, you acknowledge that you have
            read, understood, and agree to be bound by these Terms of Service.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  .legal-page {
    background-color: var(--color-gray-50);
    min-height: 100vh;
    padding: var(--space-16) 0;

    @media (min-width: 768px) {
      padding: var(--space-24) 0;
    }
  }

  .legal-content {
    max-width: 800px;
    margin: 0 auto;
    background-color: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow-wrap: break-word;
    word-break: break-word;

    @media (min-width: 768px) {
      padding: var(--space-16);
    }
  }

  .legal-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
    line-height: var(--line-height-tight);

    @media (min-width: 768px) {
      font-size: var(--font-size-5xl);
    }
  }

  // Date metadata in mono per §5, closed with the same hairline rule the page
  // mastheads use, so the legal pages share their title rhythm.
  .legal-meta {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray-600);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-hairline);
  }

  .legal-intro {
    padding: var(--space-6);
    background-color: var(--color-accent-light);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-12);

    p {
      font-size: var(--font-size-base);
      line-height: var(--line-height-relaxed);
      color: var(--color-gray-700);
      margin: 0;
    }
  }

  .legal-section {
    margin-bottom: var(--space-12);

    h2 {
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-light);
      color: var(--color-gray-900);
      margin-bottom: var(--space-6);
      padding-top: var(--space-4);
      border-top: 2px solid var(--color-gray-200);

      @media (min-width: 768px) {
        font-size: var(--font-size-3xl);
      }
    }

    h3 {
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-semibold);
      color: var(--color-gray-800);
      margin-top: var(--space-6);
      margin-bottom: var(--space-4);
    }

    p {
      font-size: var(--font-size-base);
      line-height: var(--line-height-relaxed);
      color: var(--color-gray-700);
      margin-bottom: var(--space-4);
    }

    ul {
      margin-left: var(--space-6);
      margin-bottom: var(--space-4);

      li {
        font-size: var(--font-size-base);
        line-height: var(--line-height-relaxed);
        color: var(--color-gray-700);
        margin-bottom: var(--space-2);

        strong {
          color: var(--color-gray-900);
          font-weight: var(--font-weight-semibold);
        }
      }
    }

    a {
      color: var(--color-primary);
      text-decoration: none;
