---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopProductList from '../../components/ShopProductList';
import { fetchCollectionByHandle, isShopEnabled } from '../../lib/shop';
import { setEdgeCache } from '../../lib/edgeCache';
import type { ShopProduct, ShopCollection } from '../../lib/shop';

export const prerender = false;
setEdgeCache(Astro.response, 'medium');

if (!isShopEnabled()) {
  return Astro.redirect('/404');
}

const { collection: collectionSlug } = Astro.params;

const storyblokToken =
  Astro.locals.runtime?.env?.STORYBLOK_TOKEN ?? import.meta.env.STORYBLOK_TOKEN;

let collection: ShopCollection | null = null;
let products: ShopProduct[] = [];

try {
  const result = await fetchCollectionByHandle(collectionSlug!, storyblokToken);
  collection = result.collection;
  products = result.products;
} catch (err) {
  console.error('Failed to fetch collection:', err);
}

if (!collection) {
  return Astro.redirect('/shop');
}

const pageTitle = `${collection.title} - Shop`;
const pageDescription =
  collection.description ||
  `Browse ${collection.title} products from Singapore Handpan Studio.`;

// Build absolute, trailing-slash URLs from Astro.site so schema matches the
// page canonical exactly (see src/components/SEO.astro + the trailing-slash
// middleware). Astro.site already ends in '/'.
const siteBase = Astro.site!.toString().replace(/\/$/, '');
const homeUrl = `${siteBase}/`;
const shopUrl = `${siteBase}/shop/`;
const collectionUrl = `${siteBase}/shop/${collection.handle}/`;

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: shopUrl },
    {
      '@type': 'ListItem',
      position: 3,
      name: collection.title,
      item: collectionUrl,
    },
  ],
};

// Product/ItemList structured data so Googlebot can index the catalogue
// (product names, prices, availability, brand) without executing the client
// island. Products are already fetched server-side above.
const productListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: collection.title,
  numberOfItems: products.length,
  itemListElement: products.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: product.title,
      ...(product.description && { description: product.description }),
      ...(product.image && { image: product.image.url }),
      url: `${siteBase}${product.shopUrl}`,
      brand: { '@type': 'Brand', name: collection.title },
      offers: {
        '@type': 'Offer',
        price: product.priceMin.amount,
        priceCurrency: product.priceMin.currencyCode,
        availability: product.availableForSale
          ? 'https://schema.org/InStock'
          : 'https://schema.org/OutOfStock',
        url: `${siteBase}${product.shopUrl}`,
      },
    },
  })),
};

const formatPrice = (p: { amount: number; currencyCode: string }) =>
  `${p.currencyCode} ${p.amount.toLocaleString('en-SG')}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${Astro.site}shop/${collection.handle}/`}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbData)}
    slot="head"
  />
  {
    products.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(productListSchema)}
        slot="head"
      />
    )
  }

  <main class="collection-page">
    <section class="hero-section">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/shop/">Shop</a></li>
            <li aria-current="page">{collection.title}</li>
          </ol>
        </nav>

        <h1 class="page-title">{collection.title}</h1>
        {
          collection.description && (
            <p class="page-description">{collection.description}</p>
          )
        }
        <p class="product-count">
          {collection.productCount}{' '}
          {collection.productCount === 1 ? 'product' : 'products'}
        </p>
      </div>
    </section>

    <section class="shop-section">
      <div class="container">
        {
          products.length === 0 ? (
            <div class="empty-state">
              <p>No products available in this collection yet.</p>
              <a href="/shop/" class="back-link">
                View all products
              </a>
            </div>
          ) : (
            <Fragment>
              {/* Crawlable, no-JS product list. The interactive island below
                  enhances it for visitors; both render from the same live
                  server-fetched `products`, so freshness is unchanged. */}
              <noscript>
                <ul class="ssr-product-list">
                  {products.map((product) => (
                    <li>
                      <a href={product.shopUrl}>{product.title}</a>
                      <span class="ssr-product-price">
                        {' '}
                        — {formatPrice(product.priceMin)}
                      </span>
                      {product.description && <p>{product.description}</p>}
                    </li>
                  ))}
                </ul>
              </noscript>
              <ShopProductList products={products} client:visible />
            </Fragment>
          )
        }

        <div class="back-section">
          <a href="/shop/" class="back-link"> &larr; Back to all products</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  .collection-page {
    min-height: 100vh;
  }

  .hero-section {
    background: linear-gradient(
      135deg,
      var(--color-primary-light) 0%,
      var(--color-accent-light) 100%
    );
    padding: var(--space-12) 0 var(--space-10);
    text-align: center;

    @media (max-width: 768px) {
      padding: var(--space-10) 0 var(--space-8);
    }
  }

  .breadcrumb {
    margin-bottom: var(--space-6);

    ol {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--space-2);
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: var(--font-size-sm);
      color: var(--color-gray-600);
      flex-wrap: wrap;
    }

    li {
      display: flex;
      align-items: center;
      gap: var(--space-2);

      &:not(:last-child)::after {
        content: '/';
        color: var(--color-gray-400);
      }
    }

    a {
      color: var(--color-gray-600);
      text-decoration: none;
      transition: color var(--transition-fast);

      &:hover {
        color: var(--color-primary);
        text-decoration: underline;
      }
    }

    [aria-current='page'] {
      color: var(--color-gray-900);
      font-weight: var(--font-weight-medium);
    }
  }

  .page-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
    line-height: var(--line-height-tight);

    @media (min-width: 768px) {
      font-size: var(--font-size-4xl);
    }
  }

  .page-description {
    font-size: var(--font-size-base);
    color: var(--color-gray-700);
    max-width: 700px;
    margin: 0 auto var(--space-3);
    line-height: var(--line-height-relaxed);

    @media (min-width: 768px) {
      font-size: var(--font-size-lg);
    }
  }

  .product-count {
    font-size: var(--font-size-sm);
    color: var(--color-gray-500);
  }

  .shop-section {
    padding: var(--space-12) 0 var(--space-16);
    background: var(--color-gray-50);

    @media (max-width: 768px) {
      padding: var(--space-8) 0 var(--space-12);
    }
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-6);

    @media (max-width: 768px) {
      padding: 0 var(--space-4);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16);
    color: var(--color-gray-600);

    p {
      font-size: var(--font-size-lg);
      margin-bottom: var(--space-6);
    }
  }

  .back-section {
    margin-top: var(--space-10);
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-fast);

    &:hover {
      color: var(--color-primary-dark, var(--color-gray-800));
      text-decoration: underline;
    }

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
      border-radius: var(--radius-sm);
    }
  }
</style>
