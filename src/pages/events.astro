---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import CMSFallback from '../components/CMSFallback.astro';
import { getStoryblokClient } from '../lib/storyblok';
import { setEdgeCache } from '../lib/edgeCache';
import { fetchEventStories, partitionEvents } from '../lib/eventsApi';
import { toSingaporeIso } from '../lib/eventDates';
import type { EventStory } from '../types/event';

export const prerender = false;
setEdgeCache(Astro.response, 'short');

const now = new Date();

/**
 * Shown only when Storyblok is unreachable. Dates are relative to now so the
 * fallback always renders as genuinely upcoming — hardcoded 2024 dates would
 * now be partitioned into the archive, leaving the outage page empty.
 */
const inDays = (days: number, time: string) =>
  `${toSingaporeIso(new Date(now.getTime() + days * 86400000)).slice(0, 10)} ${time}`;

const FALLBACK_EVENTS: EventStory[] = [
  {
    id: 'fallback-1',
    name: 'Beginner Handpan Workshop',
    slug: 'beginner-handpan-workshop',
    content: {
      title: 'Beginner Handpan Workshop',
      description:
        'Join us for an introduction to the beautiful world of handpan music. Perfect for complete beginners who want to learn the basics in a supportive environment.',
      date: inDays(7, '19:00'),
      duration: 2,
      location: 'Singapore Handpan Studio',
      price: 'S$120',
      booking_url:
        import.meta.env.PUBLIC_ACUITY_WORKSHOP_URL ||
        'https://app.acuityscheduling.com/schedule.php',
      tags: ['workshop', 'beginner'],
      status: 'upcoming',
      max_participants: 6,
      seo_title: 'Beginner Handpan Workshop Singapore - Learn Handpan Music',
      seo_description:
        'Join our beginner-friendly handpan workshop in Singapore. Learn the basics of this beautiful instrument with experienced instructors.',
    },
  },
  {
    id: 'fallback-2',
    name: 'Community Handpan Gathering',
    slug: 'community-handpan-gathering',
    content: {
      title: 'Community Handpan Gathering',
      description:
        'A relaxed gathering for handpan enthusiasts to play together, share music, and connect with fellow musicians in Singapore.',
      date: inDays(14, '15:00'),
      duration: 2,
      location: 'Singapore Handpan Studio',
      price: 'Free',
      tags: ['community', 'gathering'],
      status: 'upcoming',
      max_participants: 15,
      seo_title: 'Community Handpan Gathering Singapore - Free Event',
      seo_description:
        'Join fellow handpan enthusiasts for a free community gathering. Share music and connect with other musicians in Singapore.',
    },
  },
];

let events: EventStory[] = [];
let cmsError = false;

const runtime = Astro.locals.runtime;
const token = runtime?.env?.STORYBLOK_TOKEN ?? import.meta.env.STORYBLOK_TOKEN;

try {
  const storyblokApi = getStoryblokClient(token);
  const storyblokVersion = import.meta.env.PROD ? 'published' : 'draft';

  events = await fetchEventStories(storyblokApi, storyblokVersion);

  if (events.length === 0) {
    cmsError = true;
    events = FALLBACK_EVENTS;
  }
} catch (error) {
  console.error('Events: Failed to load from Storyblok', error);
  cmsError = true;
  events = FALLBACK_EVENTS;
}

// Past events live on /events/archive/ now. Keeping them here meant the page
// grew without bound — 34 of 43 cards were finished classes.
const { upcoming: upcomingEvents, past: pastEvents } = partitionEvents(
  events,
  now
);
const hasArchive = pastEvents.length > 0;

const seoTitle = 'Handpan Classes & Events in Singapore';
const seoDescription =
  'Handpan lessons for beginners and advanced players in Singapore. Private and group classes, workshops, masterclasses, sound healing sessions and community jam events.';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`${Astro.site}events/`}
>
  <main class="events-page">
    {cmsError && <CMSFallback type="events" />}

    <!-- Masthead band wraps the container, matching about/contacts/shop/stories,
         so its ground and hairline rule run the full width of the viewport. -->
    <header class="page-header">
      <div class="container">
        <h1>Classes & Events</h1>
        <p class="page-subtitle">
          Join our handpan classes, workshops, and community gatherings. Whether
          you're a complete beginner or seasoned player — all levels welcome!
        </p>
      </div>
    </header>

    <div class="container">
      {
        upcomingEvents.length > 0 && (
          <section class="events-section">
            <h2>Upcoming Classes & Events</h2>
            <div class="events-grid">
              {upcomingEvents.map((item) => (
                <EventCard
                  event={item.story}
                  timing={item.timing}
                  next={item.next}
                />
              ))}
            </div>
          </section>
        )
      }

      {
        upcomingEvents.length === 0 && (
          <section class="no-events">
            <h2>No Classes Available Right Now</h2>
            <p>
              We're currently planning our next classes and events. Check back
              soon or <a href="/contacts/">contact us</a> to stay updated!
            </p>
          </section>
        )
      }

      {
        hasArchive && (
          <aside class="archive-link">
            <p>
              Looking for something we've already run? Every past class and
              event stays online, grouped by month.
            </p>
            <a href="/events/archive/" class="archive-link__cta">
              Browse past classes
              <span aria-hidden="true">&rarr;</span>
            </a>
          </aside>
        )
      }
    </div>
  </main>

  <script src="../scripts/availability-hydration.ts"></script>
</BaseLayout>

<style lang="scss">
  @use 'src/styles/tokens.scss';

  // No top padding: the masthead below owns the space above the title, the
  // same way `.page-hero` does on about and contacts. Leaving it here stacked
  // an extra 32px on top of the masthead's own padding.
  .events-page {
    min-height: calc(100vh - var(--header-height) - var(--footer-height));
    padding: 0 0 var(--spacing-xl);
  }
  // `.container` comes from global.scss. The override that used to live here
  // matched the global max-width but flattened the padding to 16px, dropping
  // the 640/1024px gutter steps every other route uses.

  // Shared masthead treatment (handoff §3): left-set, light display type, ink
  // not bronze — bronze is reserved for eyebrows, links and hairlines.
  //
  // Vertical rhythm matches `.page-hero` on about and contacts. Round 1
  // unified the alignment, weight, colour and hairline rule of every masthead
  // but not their padding, so this band had no top padding at all — the space
  // above the title came incidentally from the page wrapper, leaving /events/
  // reading a third as tall as /about/.
  //
  // Structurally identical to `.page-hero` on about and contacts now: the band
  // wraps `.container`, so the ground and the hairline rule run full-bleed
  // rather than stopping at the 1176px content box.
  .page-header {
    text-align: left;
    background: var(--color-gray-50);
    padding: var(--space-20) 0 var(--space-16);
    margin-bottom: var(--spacing-2xl);
    border-bottom: 1px solid var(--color-hairline);

    @media (min-width: 768px) {
      padding: var(--space-24) 0 var(--space-16);
    }

    h1 {
      font-size: var(--font-size-4xl);
      font-weight: var(--font-weight-light);
      color: var(--color-gray-900);
      margin-bottom: var(--spacing-md);

      @media (min-width: 768px) {
        font-size: var(--font-size-5xl);
      }
    }

    .page-subtitle {
      font-size: var(--font-size-lg);
      color: var(--color-gray-600);
      max-width: 56ch;
      line-height: var(--line-height-relaxed);
    }
  }

  .events-section {
    margin-bottom: var(--spacing-2xl);

    h2 {
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-primary);
      margin-bottom: var(--spacing-lg);
      padding-bottom: var(--spacing-sm);
      border-bottom: 2px solid var(--color-accent);
    }
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--spacing-lg);

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  // Sits below the upcoming grid rather than in the primary nav: the archive is
  // a destination you look for, not one of the six things the site is about.
  .archive-link {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);

    p {
      color: var(--color-text-secondary);
      max-width: 48ch;
      margin: 0;
    }
  }

  .archive-link__cta {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;

    span {
      display: inline-block;
      margin-left: var(--spacing-xs);
      transition: transform var(--transition-fast);
    }

    &:hover span,
    &:focus-visible span {
      transform: translateX(3px);
    }

    @media (prefers-reduced-motion: reduce) {
      span {
        transition: none;
      }

      &:hover span,
      &:focus-visible span {
        transform: none;
      }
    }
  }

  .no-events {
    text-align: center;
    padding: var(--spacing-2xl) var(--spacing-lg);
    background: var(--color-surface);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--color-border);

    h2 {
      font-size: var(--font-size-xl);
      color: var(--color-text-primary);
      margin-bottom: var(--spacing-md);
    }

    p {
      color: var(--color-text-secondary);
      font-size: var(--font-size-md);

      a {
        color: var(--color-primary);
        text-decoration: none;
        font-weight: var(--font-weight-semibold);

        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
</style>
