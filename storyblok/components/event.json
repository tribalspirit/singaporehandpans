{
  "name": "event",
  "display_name": "Event",
  "schema": {
    "title": {
      "type": "text",
      "pos": 0,
      "required": true,
      "description": "Event title"
    },
    "description": {
      "type": "textarea",
      "pos": 1,
      "required": true,
      "description": "Event description"
    },
    "date": {
      "type": "datetime",
      "pos": 2,
      "required": true,
      "description": "Start date and time. For a repeating class, set this to the FIRST session — the weekday and time of every repeat come from here."
    },
    "end_date": {
      "type": "datetime",
      "pos": 3,
      "required": false,
      "description": "End date and time. Set this for multi-day events (e.g. a Sat–Sun masterclass). For a repeating class this is the end of the FIRST session; the same length is applied to every repeat. Leave blank to use Duration instead."
    },
    "recurrence": {
      "type": "option",
      "pos": 4,
      "required": false,
      "default_value": "none",
      "options": [
        {
          "name": "Does not repeat",
          "value": "none"
        },
        {
          "name": "Every week",
          "value": "weekly"
        },
        {
          "name": "Every 2 weeks",
          "value": "biweekly"
        },
        {
          "name": "Every month",
          "value": "monthly"
        }
      ],
      "description": "Repeat pattern. Use this instead of creating one event per session."
    },
    "recurrence_until": {
      "type": "datetime",
      "pos": 5,
      "required": false,
      "description": "Last date the repeating class runs. Required when Recurrence is set — if left blank the site only shows 12 months of repeats."
    },
    "duration": {
      "type": "number",
      "pos": 6,
      "required": false,
      "description": "Approximate event duration in hours (e.g., 1.5, 2). Ignored when End date is set."
    },
    "location": {
      "type": "text",
      "pos": 7,
      "required": true,
      "default_value": "Singapore Handpan Studio",
      "description": "Event location"
    },
    "price": {
      "type": "text",
      "pos": 8,
      "required": false,
      "description": "Event price (e.g., S$120, Free)"
    },
    "booking_url": {
      "type": "text",
      "pos": 9,
      "required": false,
      "description": "Acuity booking page URL (fallback)"
    },
    "image": {
      "type": "asset",
      "pos": 10,
      "required": false,
      "filetypes": ["images"],
      "description": "Event featured image"
    },
    "tags": {
      "type": "options",
      "pos": 11,
      "required": false,
      "options": [
        {
          "name": "Workshop",
          "value": "workshop"
        },
        {
          "name": "Performance",
          "value": "performance"
        },
        {
          "name": "Community",
          "value": "community"
        },
        {
          "name": "Beginner",
          "value": "beginner"
        },
        {
          "name": "Intermediate",
          "value": "intermediate"
        },
        {
          "name": "Advanced",
          "value": "advanced"
        },
        {
          "name": "Private",
          "value": "private"
        }
      ],
      "description": "Event categories (multiple allowed)"
    },
    "status": {
      "type": "option",
      "pos": 12,
      "required": true,
      "default_value": "upcoming",
      "options": [
        {
          "name": "Upcoming",
          "value": "upcoming"
        },
        {
          "name": "Past",
          "value": "past"
        },
        {
          "name": "Cancelled",
          "value": "cancelled"
        }
      ],
      "description": "Only 'Cancelled' has any effect — it marks the event cancelled for search engines. Upcoming vs past is worked out from the date automatically; you never need to change this."
    },
    "availability_status": {
      "type": "option",
      "pos": 13,
      "required": false,
      "default_value": "available",
      "options": [
        {
          "name": "Available",
          "value": "available"
        },
        {
          "name": "Few Spots Left",
          "value": "few_spots"
        },
        {
          "name": "Sold Out",
          "value": "sold_out"
        }
      ],
      "description": "Availability status shown on event cards"
    },
    "max_participants": {
      "type": "number",
      "pos": 14,
      "required": false,
      "description": "Maximum number of participants"
    },
    "seo_title": {
      "type": "text",
      "pos": 15,
      "required": false,
      "description": "SEO title override"
    },
    "seo_description": {
      "type": "textarea",
      "pos": 16,
      "required": false,
      "max_length": 160,
      "description": "SEO meta description"
    },
    "acuity_type": {
      "type": "option",
      "pos": 17,
      "required": false,
      "options": [
        {
          "name": "Workshop",
          "value": "workshop"
        },
        {
          "name": "Private Session",
          "value": "private"
        }
      ],
      "description": "Acuity booking type"
    },
    "acuity_appointment_type_id": {
      "type": "text",
      "pos": 18,
      "required": false,
      "description": "Acuity appointment type ID"
    },
    "acuity_class_id": {
      "type": "text",
      "pos": 19,
      "required": false,
      "description": "Acuity class ID (for workshop capacity tracking)"
    },
    "sold_out_override": {
      "type": "boolean",
      "pos": 20,
      "required": false,
      "default_value": false,
      "description": "Force sold-out display regardless of Acuity availability"
    },
    "spots_remaining": {
      "type": "number",
      "pos": 21,
      "required": false,
      "description": "Number of spots remaining (updated automatically via webhook)"
    }
  },
  "image": null,
  "preview_field": "title",
  "is_root": true,
  "preview_tmpl": null,
  "is_nestable": false,
  "all_presets": [],
  "preset_id": null,
  "real_name": "event",
  "component_group_uuid": null
}
