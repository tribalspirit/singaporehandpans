# Template for .dev.vars — copy to `.dev.vars` and fill in. Never commit `.dev.vars`.
#
#   cp .dev.vars.example .dev.vars
#
# Why this file exists alongside .env:
#
#   .env       build-time and PUBLIC_* vars. Reaches import.meta.env, which
#              Vite inlines into the build output. Safe for anything the
#              browser may see; NOT safe for payment secrets.
#   .dev.vars  server-side runtime secrets. @astrojs/cloudflare runs a platform
#              proxy in dev, so these arrive via Astro.locals.runtime.env —
#              the same path used on Cloudflare Pages. Nothing here is inlined.
#
# Server code (src/lib/hitpay.ts, src/lib/orderEmail.ts) reads the runtime env,
# so HitPay and Resend values belong here, not in .env.
#
# This file is the local mirror of the Cloudflare Pages secrets.
# See docs/deployment/CLOUDFLARE.md for the per-environment matrix.

# --- HitPay ----------------------------------------------------------------
# Sandbox: https://api.sandbox.hit-pay.com   Live: https://api.hit-pay.com
# All three are required together — getHitPayConfig() returns null if any one
# is missing, and checkout then fails with ?checkout=error.
#
# WARNING when pointed at the live URL: a checkout started locally creates a
# real, payable payment request, and HitPay emails a real receipt to whatever
# address is entered.
HITPAY_API_URL=https://api.sandbox.hit-pay.com
HITPAY_API_KEY=
HITPAY_SALT=

# --- Storyblok -------------------------------------------------------------
STORYBLOK_TOKEN=

# --- Order notifications (Resend) ------------------------------------------
# All three required together. Without them a paid HitPay order is acknowledged
# but nobody is notified, and orders are not persisted anywhere.
#
# These also gate direct PayNow below: a bank transfer has no webhook, so the
# owner's inbox is the only record a PayNow order exists.
RESEND_API_KEY=
SHOP_EMAIL_FROM=shop@singaporehandpans.com
SHOP_ORDER_EMAIL=

# --- Direct PayNow (optional) ----------------------------------------------
# Lets a buyer pay by bank transfer straight to the studio, which costs nothing,
# instead of through HitPay. Set all three, plus Resend above, to switch it on.
#
# While these are unset, the shop behaves exactly as before: one HitPay
# checkout offering both PayNow and card, at the list price with no surcharge.
#
# Once set, the product page offers two prices — PayNow at the list price, and
# card at list + 2.8% + S$0.50 (HitPay's online domestic card rate) — and the
# HitPay checkout is restricted to cards so the quoted surcharge always matches
# what the buyer actually pays.
#
# PAYNOW_PROXY_TYPE is "uen" or "mobile".
# PAYNOW_PROXY_VALUE is the UEN (e.g. 201912345K) or mobile (e.g. +6591234567).
# PAYNOW_MERCHANT_NAME is shown to the payer; EMVCo truncates it at 25 chars.
PAYNOW_PROXY_TYPE=uen
PAYNOW_PROXY_VALUE=
PAYNOW_MERCHANT_NAME=Singapore Handpan Studio
