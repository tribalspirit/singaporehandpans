{
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:astro/recommended",
    "plugin:jsx-a11y/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "react-hooks"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "ignorePatterns": ["dist/", ".astro/", "node_modules/", "*.min.js"],
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "prefer-const": "error",
    "no-var": "error",
    "no-multiple-empty-lines": [
      "error",
      {
        "max": 1,
        "maxEOF": 0,
        "maxBOF": 0
      }
    ],
    "eol-last": ["error", "always"],
    "jsx-a11y/no-redundant-roles": [
      "error",
      {
        "ul": ["list"]
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "overrides": [
    {
      "files": ["*.astro"],
      "parser": "astro-eslint-parser",
      "parserOptions": {
        "parser": "@typescript-eslint/parser",
        "extraFileExtensions": [".astro"]
      }
    },
    {
      "files": [
        "src/widgets/academy-handpan/core/**/*.ts",
        "src/widgets/academy-handpan/config/**/*.ts",
        "src/widgets/academy-handpan/theory/**/*.ts"
      ],
      "excludedFiles": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "The handpan data and theory layers must stay framework-free. Keep React in ui/."
              },
              {
                "name": "react-dom",
                "message": "The handpan data and theory layers must stay framework-free. Keep React in ui/."
              },
              {
                "name": "tone",
                "message": "The handpan data and theory layers must stay audio-free. Keep Tone.js in audio/, where it is also lazily imported."
              }
            ],
            "patterns": [
              {
                "group": ["**/ui/**", "../ui/*", "./ui/*"],
                "message": "Data and theory must not depend on the UI layer. Dependencies point one way: ui -> theory/config, never back."
              },
              {
                "group": ["**/audio/**", "../audio/*", "./audio/*"],
                "message": "Data and theory must not depend on the audio layer."
              },
              {
                "group": [
                  "**/styles/**",
                  "../styles/*",
                  "./styles/*",
                  "*.scss",
                  "**/*.scss"
                ],
                "message": "Data and theory must not import styles."
              }
            ]
          }
        ]
      }
    }
  ]
}
